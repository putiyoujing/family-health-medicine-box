.auth-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  display: flex;
  padding: 32rpx;
  background: rgba(0, 0, 0, 0.45);
}

.auth-overlay-center {
  align-items: center;
  justify-content: center;
}

.auth-overlay-bottom {
  align-items: flex-end;
  justify-content: center;
  padding: 0;
}

.auth-dialog {
  width: 100%;
  box-sizing: border-box;
  background: #ffffff;
  color: #191919;
}

.privacy-dialog {
  max-width: 640rpx;
  padding: 40rpx 32rpx 32rpx;
  border-radius: 28rpx;
}

.auth-dialog-title {
  color: #18322d;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
}

.auth-dialog-subtitle {
  margin-top: 8rpx;
  color: #5f746f;
  font-size: 24rpx;
}

.privacy-copy {
  font-size: 28rpx;
  line-height: 1.6;
  text-align: left;
}

.privacy-contract {
  margin: 24rpx 0 0;
}

.privacy-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.privacy-action {
  flex: 1;
  margin: 0;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.profile-fields {
  width: 100%;
  box-sizing: border-box;
  padding-top: 8rpx;
}

.avatar-row,
.nickname-row {
  width: 100%;
  min-height: 104rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  border-bottom: 1rpx solid #e5e5e5;
  background: transparent;
  color: #191919;
  font-size: 32rpx;
  line-height: 1.4;
  text-align: left;
}

.field-label {
  flex: none;
}

.avatar-row::after {
  border: 0;
}

.avatar-value {
  margin-left: auto;
  display: flex;
  flex: 0 0 auto;
  justify-content: flex-end;
  align-items: center;
  gap: 16rpx;
}

.avatar-preview {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
}

.field-arrow {
  color: #576b95;
  font-size: 48rpx;
  line-height: 1;
}

.nickname-input {
  flex: 1;
  min-height: 104rpx;
  margin-left: 32rpx;
  text-align: right;
}

.login-sheet {
  padding-top: 36rpx;
  padding-right: 32rpx;
  padding-left: 32rpx;
  padding-bottom: calc(32rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
}

.login-sheet-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  width: 100%;
  box-sizing: border-box;
}

.login-sheet-header > view:first-child {
  flex: 1;
  min-width: 0;
}

.login-sheet-header .auth-close {
  width: 56rpx;
  min-width: 56rpx;
  max-width: 56rpx;
  height: 56rpx;
  min-height: 56rpx;
  flex: 0 0 56rpx;
  align-self: flex-start;
  margin: 0;
  padding: 0;
  color: #8aa19a;
  background: transparent;
  font-size: 48rpx;
  line-height: 56rpx;
  text-align: center;
}

.auth-close::after {
  border: 0;
}

.login-sheet .field-label {
  display: block;
  flex: 0 0 auto;
  margin: 0;
  color: #191919;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 1.4;
}

.login-sheet .avatar-row,
.login-sheet .nickname-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.login-sheet .avatar-row {
  width: 100%;
  padding: 0;
  text-align: left;
}

.login-sheet .nickname-input {
  width: auto;
  max-width: none;
  min-width: 0;
  flex: 1;
  padding: 0;
  color: #191919;
  background: transparent;
  border: 0;
  font-size: 30rpx;
  line-height: 1.4;
}

.auth-login-actions {
  display: flex;
  gap: 20rpx;
}

.auth-login-action {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  min-height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  border-radius: 12rpx;
  margin: 0;
}
