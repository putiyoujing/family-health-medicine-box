<view
  wx:if="{{privacyVisible}}"
  class="auth-overlay auth-overlay-center"
  catchtouchmove="stopTouchMove"
>
  <view class="auth-dialog privacy-dialog">
    <view class="auth-dialog-title">隐私保护提示</view>
    <view class="privacy-copy">
      为完成登录，需要使用你的头像和昵称。我们只在你主动操作时收集，并用于账户资料与家庭协作展示。
    </view>
    <button class="privacy-contract" size="mini" type="default" bindtap="openPrivacyContract">查看隐私保护指引</button>
    <view class="privacy-actions">
      <button class="privacy-action" size="mini" type="default" bindtap="onPrivacyReject">暂不使用</button>
      <button
        id="privacy-agree-button"
        class="privacy-action"
        size="mini"
        type="primary"
        open-type="agreePrivacyAuthorization"
        bind:agreeprivacyauthorization="onPrivacyAgree"
      >同意并继续</button>
    </view>
  </view>
</view>

<view
  wx:if="{{loginVisible}}"
  class="auth-overlay auth-overlay-bottom"
  catchtouchmove="stopTouchMove"
>
  <view class="auth-dialog login-sheet">
    <view class="login-sheet-header">
      <view>
        <view class="auth-dialog-title">家人健康记 申请</view>
        <view class="auth-dialog-subtitle">获取你的昵称、头像</view>
      </view>
      <button
        wx:if="{{!submitting}}"
        class="auth-close"
        aria-label="关闭"
        bindtap="cancelLogin"
      >×</button>
    </view>
    <view class="profile-fields">
      <button
        class="avatar-row"
        open-type="chooseAvatar"
        bindchooseavatar="onChooseAvatar"
        disabled="{{submitting}}"
      >
        <text class="field-label">头像</text>
        <view class="avatar-value">
          <image
            class="avatar-preview"
            src="{{avatarUrl || '/assets/tabbar/user-default.png'}}"
            mode="aspectFill"
          ></image>
          <text class="field-arrow">›</text>
        </view>
      </button>
      <view class="nickname-row">
        <text class="field-label">昵称</text>
        <input
          class="nickname-input"
          name="nickname"
          type="nickname"
          value="{{nickname}}"
          placeholder="点击填写"
          maxlength="80"
          cursor-spacing="24"
          disabled="{{submitting}}"
          bindinput="onNicknameInput"
          bindnicknamereview="onNicknameReview"
        />
      </view>
    </view>
    <view class="auth-login-actions">
      <button
        class="auth-login-action"
        type="default"
        data-value="cancel"
        bind:tap="onLoginButtonTap"
        disabled="{{submitting}}"
      >拒绝</button>
      <button
        class="auth-login-action"
        type="primary"
        data-value="confirm"
        bind:tap="onLoginButtonTap"
        disabled="{{submitting}}"
      >允许</button>
    </view>
  </view>
</view>
