page {
  min-height: 100vh;
  color: #18322d;
  background: #f4fbf8;
  font-family: "Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
}

view,
text,
button,
input,
textarea,
picker {
  box-sizing: border-box;
}

button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  line-height: 1;
  border-radius: 999rpx;
  max-width: 100%;
  white-space: normal;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 28rpx 32rpx 132rpx;
  background: #f4fbf8;
}

.page view,
.page text,
.page button,
.page input,
.page textarea,
.page picker {
  min-width: 0;
}

.page-title {
  margin: 16rpx 0 24rpx;
}

.eyebrow {
  color: #5f746f;
  font-size: 24rpx;
  font-weight: 700;
}

.h1 {
  margin-top: 4rpx;
  color: #18322d;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.2;
}

.section {
  margin-bottom: 24rpx;
  padding: 28rpx;
  background: #ffffff;
  border: 1rpx solid #ddeee8;
  border-radius: 28rpx;
  box-shadow: 0 16rpx 44rpx rgba(10, 36, 28, 0.04);
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  color: #18322d;
  font-size: 30rpx;
  font-weight: 900;
}

.muted {
  color: #5f746f;
  font-size: 24rpx;
}

.safety {
  padding: 20rpx;
  color: #74301f;
  background: #ffe7e2;
  border-radius: 14rpx;
  font-size: 24rpx;
}

.primary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  color: #ffffff;
  background: #259f8e;
  font-size: 28rpx;
  font-weight: 900;
  border-radius: 999rpx;
  box-shadow: 0 16rpx 36rpx rgba(10, 36, 28, 0.16);
}

.ghost-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  color: #174f46;
  background: #ddf7f0;
  border: 1rpx solid #a5e4d8;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.field {
  margin-bottom: 16rpx;
}

.field-label {
  display: block;
  margin-bottom: 8rpx;
  color: #5f746f;
  font-size: 24rpx;
  font-weight: 700;
}

.input,
.textarea,
.picker-value {
  width: 100%;
  max-width: 100%;
  min-height: 88rpx;
  padding: 20rpx 28rpx;
  color: #18322d;
  background: #ffffff;
  border: 1rpx solid #cfe7e1;
  border-radius: 28rpx;
}

.textarea {
  min-height: 176rpx;
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 14rpx;
  color: #174f46;
  background: #ddf7f0;
  border: 1rpx solid #a5e4d8;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

.warn-pill {
  color: #b86b00;
  background: #fff2d8;
}

.danger-pill {
  color: #b23434;
  background: #ffe7e2;
}

.card-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.record-card {
  padding: 30rpx 34rpx;
  background: #ffffff;
  border: 1rpx solid #ddeee8;
  border-radius: 28rpx;
  box-shadow: 0 16rpx 44rpx rgba(10, 36, 28, 0.04);
}

.record-head {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 10rpx;
}

.record-head > view,
.row > view,
.section-title > view {
  min-width: 0;
}

.record-head .pill {
  flex: 0 0 auto;
}

.record-title {
  color: #18322d;
  font-size: 28rpx;
  font-weight: 900;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.grid-2 {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.grid-2 > view {
  min-width: 0;
}

.empty {
  padding: 48rpx 24rpx;
  color: #5f746f;
  text-align: center;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid #ddeee8;
  border-radius: 28rpx;
}
