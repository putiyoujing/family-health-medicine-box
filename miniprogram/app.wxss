page {
  min-height: 100vh;
  color: #1d2722;
  background: #f5f7f2;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
}

view,
text,
button,
input,
textarea,
picker {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  line-height: 1.4;
  border-radius: 12rpx;
}

button::after {
  border: 0;
}

.page {
  padding: 28rpx;
}

.page-title {
  margin-bottom: 24rpx;
}

.eyebrow {
  color: #66726c;
  font-size: 22rpx;
  font-weight: 700;
}

.h1 {
  margin-top: 6rpx;
  color: #102018;
  font-size: 42rpx;
  font-weight: 800;
}

.section {
  margin-bottom: 24rpx;
  padding: 24rpx;
  background: #ffffff;
  border: 1rpx solid #dce4dd;
  border-radius: 16rpx;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  font-size: 32rpx;
  font-weight: 800;
}

.muted {
  color: #66726c;
  font-size: 24rpx;
}

.safety {
  padding: 20rpx;
  color: #74301f;
  background: #ffe7e2;
  border-radius: 14rpx;
  font-size: 24rpx;
}

.primary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  color: #ffffff;
  background: #2f7d57;
  font-size: 28rpx;
  font-weight: 700;
}

.ghost-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  color: #1d2722;
  background: #eef4ef;
  font-size: 26rpx;
}

.field {
  margin-bottom: 18rpx;
}

.field-label {
  display: block;
  margin-bottom: 8rpx;
  color: #66726c;
  font-size: 24rpx;
  font-weight: 700;
}

.input,
.textarea,
.picker-value {
  width: 100%;
  min-height: 78rpx;
  padding: 18rpx 20rpx;
  color: #1d2722;
  background: #ffffff;
  border: 1rpx solid #dce4dd;
  border-radius: 12rpx;
}

.textarea {
  min-height: 160rpx;
}

.pill {
  display: inline-flex;
  padding: 8rpx 14rpx;
  color: #195b3a;
  background: #dff0e7;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.warn-pill {
  color: #b86b00;
  background: #fff2d8;
}

.danger-pill {
  color: #b23434;
  background: #ffe7e2;
}

.card-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.record-card {
  padding: 22rpx;
  background: #fbfdfb;
  border: 1rpx solid #dce4dd;
  border-radius: 14rpx;
}

.record-head {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 10rpx;
}

.record-title {
  font-size: 30rpx;
  font-weight: 800;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.empty {
  padding: 48rpx 24rpx;
  color: #66726c;
  text-align: center;
  background: #eef4ef;
  border-radius: 14rpx;
}
