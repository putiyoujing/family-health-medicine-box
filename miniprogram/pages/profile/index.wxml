<view class="page">
  <view class="page-title">
    <text class="eyebrow">家庭与数据</text>
    <view class="h1">{{family.name || '家庭设置'}}</view>
  </view>

  <view class="section">
    <view class="section-title">家庭成员</view>
    <view class="record-card" wx:for="{{members}}" wx:key="_id">
      <view class="record-title">{{item.name}}</view>
      <view class="muted">{{item.relation}} · 过敏史：{{item.allergyHistory || '未记录'}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">添加成员</view>
    <view class="field">
      <text class="field-label">名称</text>
      <input class="input" data-field="name" value="{{form.name}}" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="field-label">关系</text>
      <input class="input" data-field="relation" value="{{form.relation}}" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="field-label">过敏史</text>
      <input class="input" data-field="allergyHistory" value="{{form.allergyHistory}}" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="field-label">既往病史</text>
      <input class="input" data-field="medicalHistory" value="{{form.medicalHistory}}" bindinput="onInput" />
    </view>
    <button class="primary-btn" bindtap="saveMember">保存成员</button>
  </view>

  <view class="section">
    <view class="section-title">数据导出</view>
    <view class="muted">导出当前家庭数据 JSON，用于备份或迁移。导出后会自动复制到剪贴板。</view>
    <button class="ghost-btn export-btn" bindtap="exportData">导出家庭数据</button>
    <textarea class="textarea export-text" value="{{exportText}}" disabled wx:if="{{exportText}}"></textarea>
  </view>

  <view class="section">
    <view class="section-title">发布配置提示</view>
    <view class="muted">上线前请在 miniprogram/app.js 填入正式云开发 envId，并在微信开发者工具中上传 login 与 healthApi 云函数。</view>
  </view>

  <view class="section">
    <view class="section-title">管理后台</view>
    <view class="muted">用于查看全局用户、家庭、药品、生病记录、用药记录、附件和风险统计。需要在云数据库 admins 集合添加管理员 openid。</view>
    <button class="ghost-btn export-btn" bindtap="openAdmin">进入管理后台</button>
  </view>
</view>
