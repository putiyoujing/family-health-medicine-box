<view class="page profile-page">
  <view wx:if="{{loggedIn}}" class="account-card" bindtap="handleProfileTap">
    <view class="account-avatar" style="{{avatarUrl ? '' : avatarStyle}}">
      <image wx:if="{{loggedIn && avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill"></image>
      <text wx:else>{{profileInitial}}</text>
    </view>
    <view class="account-copy">
      <view class="account-name">{{profileName}}</view>
      <view wx:if="{{user.publicUserId}}" class="account-user-id">用户ID：{{user.publicUserId}}</view>
      <view class="account-subtitle" wx:if="{{!loggedIn}}">登录后可同步家庭健康记录</view>
    </view>
    <view class="account-entry">
      <text class="entry-arrow">›</text>
    </view>
  </view>

  <view wx:else class="account-card guest-account-card" bindtap="login">
    <view class="account-avatar guest-avatar">
      <image class="guest-avatar-icon" src="/assets/tabbar/user-default.png" mode="aspectFit"></image>
    </view>
    <view class="account-copy">
      <view class="account-name login-name">点击登录</view>
    </view>
    <view class="account-entry"><text class="entry-arrow">›</text></view>
  </view>

  <view class="membership-card" bindtap="openMembership">
    <view class="membership-glow"></view>
    <view class="membership-head">
      <view>
        <view class="card-kicker">会员权益</view>
        <view class="membership-title">{{loggedIn ? (entitlement.planName || '免费版') : '登录后查看当前等级'}}</view>
      </view>
      <view class="membership-action">{{isFreeMembership ? '兑换会员' : '查看权益'}} <text>›</text></view>
    </view>
    <view class="membership-message">兑换会员后可获得更多成员、账号协作和长期记录能力</view>
    <view class="benefit-strip">
      <view class="benefit-item">
        <view class="benefit-icon">员</view>
        <view>
          <view class="benefit-name">更多成员</view>
          <view class="benefit-desc">最多 10 位</view>
        </view>
      </view>
      <view class="benefit-item">
        <view class="benefit-icon">享</view>
        <view>
          <view class="benefit-name">成员协作</view>
          <view class="benefit-desc">家人共维护</view>
        </view>
      </view>
      <view class="benefit-item">
        <view class="benefit-icon">久</view>
        <view>
          <view class="benefit-name">长期记录</view>
          <view class="benefit-desc">留存更完整</view>
        </view>
      </view>
    </view>
  </view>

  <view class="family-card" bindtap="openFamily">
    <view class="services-head family-head">
      <view>
        <view class="section-heading">家庭管理</view>
        <view class="family-name">{{family.name || '我的家庭健康记录'}}</view>
      </view>
      <view class="family-count">{{members.length || 0}} / {{memberLimit}} 位</view>
    </view>
    <view class="family-action">
      <view class="family-action-icon mint">家</view>
      <view class="family-action-copy">
        <view class="family-action-title">家庭人员与协作权限</view>
        <view class="family-action-desc">添加成员、关联账号、切换家庭和管理权限</view>
      </view>
      <text class="family-arrow">›</text>
    </view>
  </view>

  <view class="services-card">
    <view class="services-head">
      <view class="section-heading">其他服务</view>
      <view class="section-caption">记录、协作与安全说明</view>
    </view>
    <view class="service-grid">
      <view class="service-item" bindtap="openLowStockSettings">
        <view class="service-icon mint">库</view>
        <text>低库存提醒</text>
      </view>
      <view class="service-item" bindtap="openExpiryReminder">
        <view class="service-icon amber">期</view>
        <text>保质期提醒</text>
      </view>
      <view class="service-item" bindtap="openReminders">
        <view class="service-icon amber">记</view>
        <text>健康待办</text>
      </view>
      <view class="service-item" bindtap="openFeedback">
        <view class="service-icon violet">评</view>
        <text>用户反馈</text>
      </view>
      <view class="service-item" data-type="privacy" bindtap="openLegal">
        <view class="service-icon mint">隐</view>
        <text>隐私说明</text>
      </view>
      <view class="service-item" data-type="terms" bindtap="openLegal">
        <view class="service-icon blue">约</view>
        <text>用户协议</text>
      </view>
      <view class="service-item" data-type="safety" bindtap="openLegal">
        <view class="service-icon coral">安</view>
        <text>医疗安全</text>
      </view>
    </view>
  </view>

</view>
<global-auth-layer id="global-auth-layer" />
