.profile-page {
  padding-bottom: 48rpx;
}

.profile-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
  padding: 32rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #27483a 0%, #3f7d5b 58%, #e6a84c 100%);
  border-radius: 20rpx;
}

.profile-hero .eyebrow {
  color: rgba(255, 255, 255, 0.78);
}

.profile-title {
  margin-top: 8rpx;
  font-size: 42rpx;
  font-weight: 800;
}

.profile-subtitle {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
}

.avatar-badge {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  color: #295039;
  background: #fff8e8;
  border-radius: 50%;
  font-size: 34rpx;
  font-weight: 800;
}

.membership-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 24rpx;
  padding: 26rpx;
  background: #ffffff;
  border: 1rpx solid #dce4dd;
  border-radius: 18rpx;
}

.card-label {
  color: #66726c;
  font-size: 22rpx;
  font-weight: 700;
}

.membership-title {
  margin: 8rpx 0;
  color: #102018;
  font-size: 34rpx;
  font-weight: 800;
}

.upgrade-pill {
  flex: 0 0 auto;
  padding: 12rpx 18rpx;
  color: #ffffff;
  background: #2f7d57;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid #eef2ef;
}

.menu-row:first-of-type {
  border-top: 0;
}

.menu-title {
  margin-bottom: 6rpx;
  color: #102018;
  font-size: 30rpx;
  font-weight: 800;
}

.menu-arrow {
  color: #95a49b;
  font-size: 46rpx;
  line-height: 1;
}

.section-count {
  color: #66726c;
  font-size: 24rpx;
  font-weight: 700;
}

.member-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.member-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx;
  background: #fbfdfb;
  border: 1rpx solid #dce4dd;
  border-radius: 14rpx;
}

.member-avatar {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  color: #2f7d57;
  background: #e5f2ea;
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: 800;
}

.member-info {
  min-width: 0;
}

.member-name {
  color: #102018;
  font-size: 30rpx;
  font-weight: 800;
}

.export-btn {
  margin-top: 20rpx;
}

.export-text {
  margin-top: 18rpx;
  min-height: 240rpx;
  font-size: 22rpx;
}

.profile-actions {
  margin-top: 18rpx;
}
