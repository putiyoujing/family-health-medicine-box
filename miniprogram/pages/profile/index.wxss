.profile-page {
  position: relative;
  padding-top: 32rpx;
  padding-bottom: 64rpx;
  overflow: hidden;
}

.profile-page::before {
  position: absolute;
  top: -180rpx;
  right: -210rpx;
  width: 520rpx;
  height: 520rpx;
  background: radial-gradient(circle, rgba(79, 197, 170, 0.2) 0%, rgba(79, 197, 170, 0) 68%);
  content: '';
  pointer-events: none;
}

.account-card {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-height: 144rpx;
  margin-bottom: 24rpx;
  padding: 24rpx 8rpx;
}

.account-card:active,
.membership-card:active,
.service-item:active {
  opacity: 0.84;
}

.account-avatar {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  overflow: hidden;
  color: #ffffff;
  background: linear-gradient(145deg, #44b8a3, #167c70);
  border: 6rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 50%;
  box-shadow: 0 14rpx 34rpx rgba(15, 93, 81, 0.16);
  font-size: 38rpx;
  font-weight: 900;
}

.account-avatar image {
  width: 100%;
  height: 100%;
}

.guest-avatar {
  background: #e8f4f0;
}

.account-avatar .guest-avatar-icon {
  width: 72rpx;
  height: 72rpx;
}

.account-copy {
  flex: 1;
  min-width: 0;
}

.account-name {
  overflow: hidden;
  color: #153b34;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.login-name {
  color: #0e7c6d;
}

.account-subtitle {
  margin-top: 8rpx;
  color: #6d837d;
  font-size: 23rpx;
}

.account-user-id {
  margin-top: 6rpx;
  color: #6d837d;
  font-size: 22rpx;
  line-height: 1.4;
}

.account-entry {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 8rpx;
}

.entry-arrow {
  color: #92a49f;
  font-size: 46rpx;
  line-height: 1;
}

.membership-card {
  position: relative;
  z-index: 1;
  margin-bottom: 24rpx;
  padding: 34rpx;
  overflow: hidden;
  color: #fffaf0;
  background: linear-gradient(135deg, #143d37 0%, #1b574c 58%, #846c3e 150%);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 32rpx;
  box-shadow: 0 22rpx 48rpx rgba(14, 59, 51, 0.18);
}

.membership-glow {
  position: absolute;
  top: -100rpx;
  right: -60rpx;
  width: 280rpx;
  height: 280rpx;
  background: radial-gradient(circle, rgba(255, 221, 149, 0.25), rgba(255, 221, 149, 0));
  border-radius: 50%;
}

.membership-head {
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.membership-head > view {
  min-width: 0;
}

.card-kicker {
  color: #d8e8e3;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.membership-title {
  margin-top: 5rpx;
  color: #fff8e8;
  font-family: "STSong", "Songti SC", serif;
  font-size: 38rpx;
  font-weight: 900;
}

.membership-action {
  position: relative;
  flex: 0 0 auto;
  padding: 11rpx 16rpx;
  color: #5a451f;
  background: #f6dfaa;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 900;
}

.membership-action text {
  margin-left: 3rpx;
  font-size: 28rpx;
}

.membership-message {
  position: relative;
  margin: 10rpx 0 26rpx;
  color: #c9dbd6;
  font-size: 23rpx;
}

.benefit-strip {
  position: relative;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.12);
}

.benefit-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.benefit-icon {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  color: #f5deb0;
  background: rgba(246, 223, 170, 0.12);
  border: 1rpx solid rgba(246, 223, 170, 0.28);
  border-radius: 14rpx;
  font-size: 20rpx;
  font-weight: 900;
}

.benefit-name {
  color: #fffaf0;
  font-size: 21rpx;
  font-weight: 800;
  overflow-wrap: anywhere;
}

.benefit-desc {
  color: #b7cec8;
  font-size: 18rpx;
  overflow-wrap: anywhere;
}

.family-card,
.services-card {
  position: relative;
  z-index: 1;
  padding: 28rpx 24rpx 22rpx;
  margin-bottom: 24rpx;
  background: #ffffff;
  border: 1rpx solid #deeee9;
  border-radius: 32rpx;
  box-shadow: 0 16rpx 44rpx rgba(10, 36, 28, 0.05);
}

.family-card {
  padding-bottom: 26rpx;
}

.family-head {
  align-items: flex-start;
}

.family-name {
  max-width: 380rpx;
  margin-top: 4rpx;
  overflow: hidden;
  color: #879a95;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.family-count {
  flex: 0 0 auto;
  padding: 7rpx 13rpx;
  color: #176f61;
  background: #e4f5ef;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 900;
}

.family-action {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 104rpx;
  padding: 18rpx 8rpx;
  background: #f5faf8;
  border-radius: 22rpx;
}

.family-action:active {
  opacity: 0.78;
}

.family-action-icon {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  font-family: "STSong", "Songti SC", serif;
  font-size: 26rpx;
  font-weight: 900;
}

.family-action-icon.mint {
  color: #167765;
  background: #dcf3ea;
}

.family-action-copy {
  flex: 1;
  min-width: 0;
}

.family-action-title {
  color: #28453e;
  font-size: 26rpx;
  font-weight: 900;
}

.family-action-desc {
  margin-top: 3rpx;
  color: #7a8f89;
  font-size: 20rpx;
}

.family-arrow {
  color: #91a49f;
  font-size: 42rpx;
  line-height: 1;
}

.services-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 8rpx 22rpx;
}

.section-heading {
  color: #18322d;
  font-size: 31rpx;
  font-weight: 900;
}

.section-caption {
  color: #8a9b97;
  font-size: 20rpx;
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  row-gap: 28rpx;
}

.service-item {
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 11rpx;
  color: #344d47;
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
}

.service-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  border-radius: 23rpx;
  font-family: "STSong", "Songti SC", serif;
  font-size: 27rpx;
  font-weight: 900;
}

.service-icon.mint {
  color: #167765;
  background: #dcf3ea;
}

.service-icon.blue {
  color: #356a80;
  background: #e2f0f5;
}

.service-icon.amber {
  color: #9b681e;
  background: #fff0d6;
}

.service-icon.coral {
  color: #a75643;
  background: #ffe7df;
}

.service-icon.violet {
  color: #6c5c91;
  background: #eee9f8;
}
