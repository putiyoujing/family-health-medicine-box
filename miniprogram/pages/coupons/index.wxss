.coupons-page{padding:30rpx 24rpx 50rpx}.page-title{color:#1a2e2b;font-size:42rpx;font-weight:800}.page-caption{margin-top:8rpx;color:#7c9089;font-size:22rpx}.coupon-tabs{display:flex;margin-top:28rpx;padding:6rpx;background:#e8f8f3;border-radius:999rpx}.coupon-tab{flex:1;padding:16rpx 0;color:#60736c;text-align:center;border-radius:999rpx;font-size:23rpx}.coupon-tab.active{color:#fff;background:#2a9d8f;font-weight:700}.coupon-card{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-top:18rpx;padding:22rpx;background:#fff;border:1rpx solid #e5efeb;border-radius:22rpx;box-shadow:0 8rpx 24rpx rgba(42,157,143,.05)}.coupon-main{display:flex;align-items:center;min-width:0}.coupon-amount{flex:0 0 120rpx;color:#2a9d8f;font-size:34rpx;font-weight:800}.coupon-info{min-width:0}.coupon-name{overflow:hidden;color:#1a2e2b;font-size:24rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}.coupon-desc,.coupon-code{margin-top:8rpx;color:#8f9e99;font-size:19rpx}.use-button{flex:0 0 126rpx;height:58rpx;margin:0;color:#2a9d8f;background:#e8f8f3;border-radius:999rpx;font-size:21rpx;line-height:58rpx}.empty-state{margin-top:100rpx;color:#8f9e99;text-align:center;font-size:23rpx}.select-hint{margin-top:22rpx;color:#8f9e99;text-align:center;font-size:20rpx}
