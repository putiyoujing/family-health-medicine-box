<view class="page coupons-page"><view class="page-title">我的优惠券</view><view class="page-caption">券名称、金额、适用套餐和有效期均来自后台配置</view><view class="coupon-tabs"><view class="coupon-tab {{activeTab === 'available' ? 'active' : ''}}" data-tab="available" bindtap="switchTab">可用</view><view class="coupon-tab {{activeTab === 'used' ? 'active' : ''}}" data-tab="used" bindtap="switchTab">已使用</view><view class="coupon-tab {{activeTab === 'expired' ? 'active' : ''}}" data-tab="expired" bindtap="switchTab">已过期</view></view><block wx:for="{{coupons}}" wx:key="code"><view wx:if="{{(activeTab === 'available' && item.statusGroup === 'active') || (activeTab === 'used' && item.statusGroup === 'used') || (activeTab === 'expired' && item.statusGroup === 'expired')}}" class="coupon-card"><view class="coupon-main"><view class="coupon-amount" wx:if="{{item.type !== 'trial_days'}}">¥{{item.value}}</view><view class="coupon-amount" wx:else>会员</view><view class="coupon-info"><view class="coupon-name">{{item.displayName}}</view><view class="coupon-desc">{{item.discountPreview || '会员优惠券'}} · 有效期至 {{item.validText}}</view><view class="coupon-code">券码 {{item.code}}</view></view></view><button wx:if="{{activeTab === 'available'}}" class="use-button" data-code="{{item.code}}" bindtap="chooseCoupon">去使用</button></view></block><view wx:if="{{!coupons.length}}" class="empty-state">当前没有可展示的优惠券</view><view wx:if="{{selectFor}}" class="select-hint">选择优惠券后将返回订单确认页</view></view>
