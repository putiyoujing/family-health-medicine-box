<view class="page coupons-page"><view class="coupon-tabs"><view class="coupon-tab {{activeTab === 'available' ? 'active' : ''}}" data-tab="available" bindtap="switchTab">可用</view><view class="coupon-tab {{activeTab === 'used' ? 'active' : ''}}" data-tab="used" bindtap="switchTab">已使用</view><view class="coupon-tab {{activeTab === 'expired' ? 'active' : ''}}" data-tab="expired" bindtap="switchTab">已过期</view></view><block wx:for="{{visibleCoupons}}" wx:key="code"><view class="coupon-card"><view class="coupon-main"><view class="coupon-amount" wx:if="{{item.type !== 'trial_days'}}">¥{{item.value}}</view><view class="coupon-amount" wx:else>会员</view><view class="coupon-info"><view class="coupon-name">{{item.displayName}}</view><view class="coupon-desc">{{item.discountPreview || '会员优惠'}} · 有效期至 {{item.validText}}</view><view class="coupon-code">券码 {{item.code}}</view></view></view><button wx:if="{{activeTab === 'available'}}" class="use-button" data-code="{{item.code}}" bindtap="chooseCoupon">去使用</button></view></block><view wx:if="{{!loading && !visibleCoupons.length}}" class="empty-state">{{emptyStateText}}</view><view wx:if="{{selectFor}}" class="select-hint">选择后会返回订单确认页</view></view>
