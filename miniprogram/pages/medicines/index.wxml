<view class="page">
  <view class="section search-section">
    <view class="search-row">
      <input class="input search-input" placeholder="搜索药品名、位置、标签" value="{{query}}" bindinput="onSearch" />
      <button class="filter-toggle {{showFilters ? 'active-toggle' : ''}}" bindtap="toggleFilters">{{activeFilterLabel}}</button>
    </view>
    <view class="active-filter-bar" wx:if="{{activeFilterText}}">
      <text>{{activeFilterText}}</text>
      <text class="clear-filter" bindtap="clearFilters">清除</text>
    </view>
    <view class="filter-panel" wx:if="{{showFilters}}">
      <view class="filter-block">
        <view class="filter-label">成员</view>
        <scroll-view scroll-x class="filter-scroll">
          <view class="filter-chip {{item.active ? 'active-filter' : ''}}" wx:for="{{memberFilters}}" wx:key="value" data-value="{{item.value}}" bindtap="selectMemberFilter">{{item.label}}</view>
        </scroll-view>
      </view>
      <view class="filter-block">
        <view class="filter-label">分类</view>
        <scroll-view scroll-x class="filter-scroll">
          <view class="filter-chip {{item.active ? 'active-filter' : ''}}" wx:for="{{categoryFilters}}" wx:key="value" data-value="{{item.value}}" bindtap="selectCategory">{{item.label}}</view>
        </scroll-view>
      </view>
      <view class="filter-block">
        <view class="filter-label">标签</view>
        <scroll-view scroll-x class="filter-scroll">
          <view class="filter-chip {{item.active ? 'active-filter' : ''}}" wx:for="{{tagFilters}}" wx:key="value" data-value="{{item.value}}" bindtap="selectTag">{{item.label}}</view>
        </scroll-view>
      </view>
      <view class="filter-summary">
        <text>当前显示 {{filteredMedicines.length}} 个药品</text>
        <text class="clear-filter" bindtap="clearFilters">重置筛选</text>
      </view>
    </view>
  </view>

  <button class="primary-btn add-btn" wx:if="{{showWriteEntries}}" bindtap="createMedicine">添加药品</button>

  <view class="card-list">
    <view class="list-heading" wx:if="{{filteredMedicines.length}}">
      <text>药箱中的药品</text>
      <text class="muted">{{filteredMedicines.length}} 个</text>
    </view>
    <view wx:if="{{!filteredMedicines.length}}" class="empty">还没有药品记录</view>
    <view class="record-card" wx:for="{{filteredMedicines}}" wx:key="_id" data-id="{{item._id}}" bindtap="editMedicine">
      <view class="record-head">
        <view>
          <view class="record-title">{{item.name}}</view>
          <view class="muted">{{item.memberName}} · {{item.category || '未分类'}} · {{item.specification || '未填规格'}}</view>
        </view>
        <text class="expire-text {{item.expireStatus === 'expired' ? 'expire-expired' : item.expireStatus === 'expiring' ? 'expire-expiring' : ''}}">{{item.expireLabel}}</text>
      </view>
      <view class="stock-row">
        <text>{{item.stockSummary}}</text>
        <text>{{item.location || '未记录位置'}}</text>
      </view>
      <view class="tag-row" wx:if="{{item.tagList.length}}">
        <text class="tag-label" wx:for="{{item.tagList}}" wx:key="*this">#{{item}}</text>
      </view>
      <view class="medicine-indication" wx:if="{{item.indicationsText}}"><text>适用：</text>{{item.indicationsText}}</view>
      <view class="medicine-instruction" wx:if="{{item.instructionText}}"><text>用法：</text>{{item.instructionText}}</view>
      <view class="muted medicine-indication" wx:if="{{!item.indicationsText && !item.instructionText}}">暂无说明记录</view>
      <view class="medicine-actions" wx:if="{{showWriteEntries}}">
        <button class="ghost-btn use-btn" data-id="{{item._id}}" catchtap="useMedicine">使用</button>
        <button class="ghost-btn edit-btn" data-id="{{item._id}}" catchtap="editMedicine">修改</button>
        <button class="delete-btn" data-id="{{item._id}}" catchtap="remove">删除</button>
      </view>
    </view>
    <view class="list-end" wx:if="{{filteredMedicines.length}}">到底了哦</view>
  </view>
</view>
<global-auth-layer id="global-auth-layer" />
