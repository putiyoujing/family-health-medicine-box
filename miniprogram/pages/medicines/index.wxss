.add-btn {
  width: 100%;
  margin-bottom: 24rpx;
}

.search-section {
  padding-bottom: 28rpx;
}

.search-row {
  display: grid;
  grid-template-columns: minmax(0, 3fr) minmax(0, 1fr);
  align-items: center;
  gap: 14rpx;
}

.search-input {
  width: 100%;
  min-width: 0;
}

.filter-toggle {
  width: 100%;
  min-width: 0;
  height: 78rpx;
  padding: 0 12rpx;
  color: #5f746f;
  background: #ffffff;
  border: 1rpx solid #ddeee8;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.active-toggle {
  color: #178575;
  background: #ffffff;
  border-color: #8bcfc3;
}

.active-filter-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  color: #5f746f;
  background: #f4fbf8;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.filter-panel {
  margin-top: 18rpx;
  padding-top: 2rpx;
}

.filter-block {
  margin-top: 18rpx;
}

.filter-label {
  margin-bottom: 10rpx;
  color: #5f746f;
  font-size: 24rpx;
  font-weight: 800;
}

.filter-scroll {
  white-space: nowrap;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 116rpx;
  height: 56rpx;
  margin-right: 12rpx;
  padding: 0 18rpx;
  color: #5f746f;
  background: #ffffff;
  border: 1rpx solid #ddeee8;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.active-filter {
  color: #174f46;
  background: #ffffff;
  border-color: #8bcfc3;
}

.filter-summary {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
  color: #5f746f;
  font-size: 24rpx;
}

.clear-filter {
  color: #259f8e;
  font-weight: 800;
}

.stock-row {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  margin: 12rpx 0;
  color: #18322d;
  font-weight: 700;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin: 14rpx 0;
}

.tag-label {
  color: #174f46;
  font-size: 22rpx;
  font-weight: 800;
}

.medicine-instruction,
.medicine-indication {
  overflow: hidden;
  margin-top: 2rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.medicine-instruction {
  color: #47625b;
  font-size: 24rpx;
}

.medicine-instruction text {
  color: #18322d;
  font-weight: 800;
}

.medicine-indication {
  color: #6f827d;
  font-size: 24rpx;
}

.medicine-indication text {
  color: #4f6660;
  font-weight: 800;
}

.medicine-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 16rpx;
}

.delete-btn {
  width: 120rpx;
  height: 56rpx;
  margin: 0;
  color: #b23434;
  background: #ffe7e2;
  font-size: 24rpx;
}

.edit-btn,
.use-btn {
  width: 120rpx;
  height: 56rpx;
  margin: 0;
  font-size: 24rpx;
}

.edit-btn {
  color: #174f46;
}

.use-btn {
  color: #ffffff;
  background: #259f8e;
  border: 0;
}

.expire-text {
  flex: 0 0 auto;
  max-width: 240rpx;
  color: #5f746f;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.4;
  text-align: right;
}

.expire-expiring {
  color: #b86b00;
}

.expire-expired {
  color: #a52222;
}

.list-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #18322d;
  font-size: 27rpx;
  font-weight: 900;
}
