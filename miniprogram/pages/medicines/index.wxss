.add-btn {
  margin-bottom: 24rpx;
}

.photo-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 22rpx;
  padding: 22rpx;
  background: #eef7f1;
  border-radius: 18rpx;
}

.photo-btn {
  flex: 0 0 auto;
  width: 132rpx;
  height: 68rpx;
  color: #ffffff;
  background: #2f7d57;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.photo-preview {
  display: flex;
  gap: 18rpx;
  margin-bottom: 22rpx;
  padding: 18rpx;
  background: #fbfdfb;
  border: 1rpx solid #dce4dd;
  border-radius: 18rpx;
}

.photo-preview image {
  flex: 0 0 auto;
  width: 144rpx;
  height: 144rpx;
  border-radius: 14rpx;
  background: #eef4ef;
}

.photo-preview-copy {
  flex: 1;
  min-width: 0;
}

.parse-btn {
  width: 200rpx;
  height: 60rpx;
  margin-top: 14rpx;
}

.stock-row {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  margin: 12rpx 0;
  color: #1d2722;
  font-weight: 700;
}

.delete-btn {
  width: 120rpx;
  height: 56rpx;
  margin-top: 16rpx;
  margin-left: auto;
  color: #b23434;
  background: #ffe7e2;
  font-size: 24rpx;
}
