.form-page {
  padding-bottom: 220rpx;
  background:
    radial-gradient(circle at 88% 2%, rgba(165, 228, 216, 0.3), transparent 34%),
    #f4fbf8;
}

.loading-state {
  padding: 160rpx 0;
  color: #5f746f;
  text-align: center;
  font-size: 26rpx;
}

.form-hero {
  margin: 12rpx 0 24rpx;
}

.prescription-progress {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  color: #267564;
  font-size: 24rpx;
  font-weight: 800;
}

.edit-previous-btn {
  flex: none;
  min-width: 0;
  height: 52rpx;
  padding: 0 20rpx;
  color: #1d7060;
  background: #e6f6f0;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 52rpx;
}

.edit-previous-btn::after {
  border: 0;
}

.hero-note {
  margin-top: 12rpx;
  color: #5f746f;
  font-size: 25rpx;
}

.section-kicker {
  margin-bottom: 20rpx;
  color: #18322d;
  font-size: 30rpx;
  font-weight: 900;
}

.photo-section {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 20rpx;
  background: linear-gradient(135deg, #ffffff 0%, #eaf9f5 100%);
  border-color: #c9e9e1;
}

.photo-copy {
  min-width: 0;
}

.photo-copy .section-kicker {
  margin-bottom: 6rpx;
}

.photo-action {
  width: 176rpx;
  padding: 0 22rpx;
}

.photo-preview-grid {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #d7ece6;
}

.photo-preview {
  position: relative;
  overflow: hidden;
  aspect-ratio: 1;
  border-radius: 18rpx;
}

.photo-preview image {
  width: 100%;
  height: 100%;
  background: #e5f4ef;
}

.photo-remove {
  position: absolute;
  right: 6rpx;
  bottom: 6rpx;
  width: 68rpx;
  height: 40rpx;
  padding: 0;
  color: #ffffff;
  background: rgba(88, 43, 37, 0.82);
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 40rpx;
}

.photo-remove::after {
  border: 0;
}

.photo-count {
  grid-column: 1 / -1;
  color: #257b69;
  font-size: 23rpx;
}

.parse-btn {
  grid-column: 1 / -1;
  width: 260rpx;
  height: 58rpx;
  margin-top: 12rpx;
  font-size: 23rpx;
}

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 88rpx;
  padding: 18rpx 24rpx;
  color: #18322d;
  background: #ffffff;
  border: 1rpx solid #cfe7e1;
  border-radius: 24rpx;
}

.picker-arrow {
  color: #8ea19c;
  font-size: 36rpx;
  line-height: 1;
}

.date-picker {
  min-height: 88rpx;
}

.placeholder {
  color: #9aa9a5;
}

.label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 38rpx;
}

.clear-value {
  color: #259f8e;
  font-size: 22rpx;
  font-weight: 700;
}

.field-control-error {
  background: #fff8f6;
  border-color: #d95f4f;
}

.field-error {
  margin-top: 8rpx;
  color: #b23434;
  font-size: 22rpx;
  line-height: 1.35;
}

.field-help {
  margin-top: 10rpx;
  color: #788c87;
  font-size: 22rpx;
  line-height: 1.5;
}

.package-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) minmax(120rpx, 0.8fr) 24rpx minmax(120rpx, 0.8fr);
  align-items: center;
  gap: 12rpx;
}

.package-input-wrap { position: relative; }
.package-prefix { position: absolute; top: 50%; left: 24rpx; z-index: 1; color: #5f746f; font-size: 26rpx; transform: translateY(-50%); }
.package-input { padding-left: 58rpx; }
.package-grid .picker-row { min-height: 82rpx; padding: 16rpx 18rpx; }
.package-divider { color: #78908a; font-size: 30rpx; text-align: center; }

.unit-input-shell {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 24rpx;
  background: #fff;
  border: 1rpx solid #cfe7e1;
  border-radius: 24rpx;
}

.unit-input { flex: 1; min-width: 0; }
.unit-suffix { margin-left: 12rpx; color: #5f746f; font-weight: 700; }
.package-stock-note { margin-top: -4rpx; color: #257b69; font-size: 22rpx; line-height: 1.5; }

.form-tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.form-tag-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 18rpx;
  color: #48665f;
  background: #eef9f5;
  border: 1rpx solid #c9e9e1;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.selected-tag {
  color: #ffffff;
  background: #259f8e;
  border-color: #259f8e;
}

.textarea {
  border-radius: 24rpx;
}

.last-field {
  margin-bottom: 0;
}

.save-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  padding: 22rpx 32rpx calc(22rpx + env(safe-area-inset-bottom));
  background: rgba(244, 251, 248, 0.96);
  border-top: 1rpx solid rgba(207, 231, 225, 0.9);
  box-shadow: 0 -18rpx 40rpx rgba(10, 36, 28, 0.08);
}

.prescription-save-bar {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.prescription-save-bar .save-btn {
  height: 88rpx;
  line-height: 88rpx;
}

.save-btn {
  width: 100%;
}
