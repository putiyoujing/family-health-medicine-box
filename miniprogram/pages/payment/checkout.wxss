.checkout-box {
  border: 2rpx solid rgba(244, 185, 95, 0.32);
}

.checkout-row {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  padding: 18rpx 0;
  color: #66726c;
}

.total-row {
  color: #24352e;
  font-size: 32rpx;
  font-weight: 800;
  border-top: 1rpx solid rgba(63, 125, 91, 0.12);
}

.total-row text:last-child {
  color: #3f7d5b;
  font-size: 44rpx;
}

.pay-btn {
  margin-top: 24rpx;
}

.pay-note {
  margin-top: 16rpx;
  text-align: center;
}
