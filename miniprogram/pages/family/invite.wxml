<view class="page">
  <view class="page-title">
    <text class="eyebrow">家庭共享</text>
    <view class="h1">邀请家人共同管理</view>
  </view>

  <view class="section">
    <view class="section-title">选择权限</view>
    <picker mode="selector" range="{{roleOptions}}" range-key="label" value="{{roleIndex}}" bindchange="onRoleChange">
      <view class="picker-value">{{roleOptions[roleIndex].label}}</view>
    </picker>
    <view class="muted permission-desc">{{roleOptions[roleIndex].desc}}</view>
    <view class="muted" wx:if="{{entitlement}}">
      当前为 {{entitlement.planName}}，可邀请角色：{{entitlement.sharedRolesText}}
    </view>
  </view>

  <view class="section">
    <view class="section-title">隐私提醒</view>
    <view class="muted">加入后，对方将能够根据角色权限查看或编辑该家庭空间内的常备记录、健康记录、用药记录和附件。请仅邀请你信任的家庭成员。</view>
  </view>

  <button class="primary-btn" bindtap="createInvite">生成邀请</button>

  <view class="section invite-result" wx:if="{{invite}}">
    <view class="section-title">邀请已生成</view>
    <view class="code">{{invite.inviteCode}}</view>
    <view class="muted">有效期至：{{invite.expiresAt}}</view>
    <view class="grid-2 action-grid">
      <button class="ghost-btn" open-type="share">微信分享</button>
      <button class="ghost-btn" bindtap="copyInvite">复制邀请码</button>
    </view>
  </view>
</view>
