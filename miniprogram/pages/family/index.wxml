<view class="page">
  <view class="page-title">
    <text class="eyebrow">家庭共享</text>
    <view class="h1">{{family.name || '家庭管理'}}</view>
  </view>

  <view class="section">
    <view class="section-title">当前家庭</view>
    <view class="record-card">
      <view class="record-title">{{family.name || '我的家庭健康记录'}}</view>
      <view class="muted">我的角色：{{family.role || 'owner'}}</view>
      <view class="muted" wx:if="{{entitlement}}">权益：{{entitlement.planName}} · 共享成员上限 {{entitlement.limits.maxSharedUsers}} 人</view>
    </view>
    <view class="grid-2 action-grid">
      <button class="ghost-btn" bindtap="openSwitch">切换家庭</button>
      <button class="ghost-btn" bindtap="openMembership">会员权益</button>
    </view>
  </view>

  <view class="section">
    <view class="section-title">
      <text>共享成员</text>
      <button class="mini-btn" bindtap="openInvite">邀请家人</button>
    </view>
    <view class="empty" wx:if="{{!roles.length}}">还没有共享成员</view>
    <view class="record-card" wx:for="{{roles}}" wx:key="_id">
      <view class="record-head">
        <view>
          <view class="record-title">{{item.nickname}}</view>
          <view class="muted">{{item.roleLabel}} · {{item.isCurrentUser ? '我自己' : '家庭成员'}}</view>
        </view>
        <text class="pill">{{item.roleLabel}}</text>
      </view>
      <view class="role-actions" wx:if="{{item.canManage}}">
        <button class="ghost-btn tiny-btn" data-openid="{{item.openid}}" data-role="admin" bindtap="changeRole">设管理员</button>
        <button class="ghost-btn tiny-btn" data-openid="{{item.openid}}" data-role="member" bindtap="changeRole">设协作者</button>
        <button class="ghost-btn tiny-btn" data-openid="{{item.openid}}" data-role="viewer" bindtap="changeRole">设查看</button>
        <button class="delete-btn" data-openid="{{item.openid}}" bindtap="removeUser">移除</button>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">隐私提醒</view>
    <view class="muted">邀请家人后，对方将能够根据角色权限查看或编辑该家庭空间内的常备记录、健康记录、用药记录和附件。请仅邀请你信任的家庭成员。</view>
  </view>
</view>
