.family-page {
  padding-bottom: 96rpx;
}

.family-summary-card {
  background: linear-gradient(145deg, #ffffff, #eff9f5);
}

.family-summary {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.family-summary > view:first-child {
  min-width: 0;
}

.family-summary .record-title {
  margin-bottom: 6rpx;
}

.family-role {
  flex: 0 0 auto;
  align-self: flex-start;
  padding: 7rpx 14rpx;
  color: #176f61;
  background: #ddf4ec;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 900;
}

.action-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 18rpx;
  width: 100%;
  margin-top: 22rpx;
}

.action-grid button {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  height: 72rpx;
  margin: 0;
  padding: 0 16rpx;
}

.action-grid .join-family-btn {
  grid-column: 1 / -1;
}

.member-section-title {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 144rpx;
  align-items: start;
  gap: 16rpx;
  width: 100%;
}

.member-section-title > view {
  min-width: 0;
}

.section-hint {
  margin-top: 4rpx;
  color: #849791;
  font-size: 20rpx;
  font-weight: 400;
}

.mini-btn {
  flex: 0 0 144rpx;
  width: 144rpx;
  min-width: 144rpx;
  max-width: 144rpx;
  height: 58rpx;
  margin: 0;
  padding: 0;
  color: #ffffff;
  background: #218f80;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 800;
  justify-self: end;
  align-self: start;
}

.member-quota {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  padding: 14rpx 18rpx;
  color: #527069;
  background: #edf8f4;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.member-list {
  display: flex;
  flex-direction: column;
}

.member-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 100rpx;
  padding: 18rpx 4rpx;
  border-top: 1rpx solid #edf5f2;
}

.member-row:first-child {
  border-top: 0;
}

.member-row:active {
  opacity: 0.76;
}

.member-avatar {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  color: #176f61;
  background: #ddf4ec;
  border-radius: 22rpx;
  font-size: 27rpx;
  font-weight: 900;
}

.member-copy {
  flex: 1;
  min-width: 0;
}

.member-account-status {
  display: inline-flex;
  margin-top: 8rpx;
  padding: 5rpx 12rpx;
  color: #60736e;
  background: #f0f5f3;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.35;
}

.member-account-status.linked {
  color: #176f61;
  background: #ddf4ec;
}

.member-account-status.pending {
  color: #866316;
  background: #fff3cc;
}

.member-invite-btn {
  flex: 0 0 auto;
  width: 132rpx;
  min-width: 132rpx;
  max-width: 132rpx;
  height: 56rpx;
  margin: 0;
  padding: 0 12rpx;
  color: #176f61;
  background: #ddf4ec;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 800;
}

.member-account-panel {
  margin-top: 22rpx;
  padding: 20rpx;
  background: #f6faf8;
  border-radius: 20rpx;
}

.account-link-btn {
  width: 100%;
  margin-top: 16rpx;
}

.row-arrow {
  color: #91a49f;
  font-size: 42rpx;
  line-height: 1;
}

.role-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 16rpx;
}

.tiny-btn,
.delete-btn {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  height: 58rpx;
  margin: 0;
  padding: 0 10rpx;
  font-size: 22rpx;
}

.delete-btn {
  color: #b23434;
  background: #ffe7e2;
  border-radius: 999rpx;
}

.privacy-card {
  margin-bottom: 0;
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 28rpx 28rpx 0;
  background: rgba(11, 42, 35, 0.45);
}

.member-modal {
  position: relative;
  width: 100%;
  max-height: 88vh;
  padding: 30rpx 30rpx 42rpx;
  overflow-y: auto;
  background: #ffffff;
  border-radius: 36rpx 36rpx 0 0;
  box-shadow: 0 -18rpx 54rpx rgba(10, 36, 28, 0.2);
}

.modal-head {
  padding-right: 82rpx;
  margin-bottom: 28rpx;
}

.modal-title {
  margin-top: 3rpx;
  color: #18322d;
  font-size: 36rpx;
  font-weight: 900;
}

.modal-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  z-index: 1;
  display: flex;
  flex: 0 0 62rpx;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  min-width: 62rpx;
  max-width: 62rpx;
  height: 62rpx;
  min-height: 62rpx;
  max-height: 62rpx;
  margin: 0;
  padding: 0;
  color: #58716b;
  background: #eef7f4;
  border-radius: 50%;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1;
}

.picker-input {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.member-modal picker {
  display: block;
  width: 100%;
}

.picker-placeholder {
  color: #91a29e;
}

.picker-arrow {
  color: #8fa39d;
  font-size: 38rpx;
  line-height: 1;
}

.field-help {
  margin: 8rpx 6rpx 0;
  color: #83958f;
  font-size: 20rpx;
  line-height: 1.5;
}

.modal-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 24rpx;
}

.modal-actions button {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  height: 82rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 900;
}

.cancel-member-btn {
  color: #176f61;
  background: #e3f6ef;
  border: 1rpx solid #b9e5d8;
}

.save-member-btn {
  color: #ffffff;
  background: #219d8c;
  box-shadow: 0 12rpx 28rpx rgba(33, 157, 140, 0.2);
}

.delete-member-btn {
  grid-column: 1 / -1;
  color: #ad3e35;
  background: #fff0ed;
}
