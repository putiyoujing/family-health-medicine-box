.orders-page{padding:30rpx 24rpx 50rpx}.page-title{color:#1a2e2b;font-size:42rpx;font-weight:800}.page-caption{margin-top:8rpx;color:#7c9089;font-size:22rpx}.order-card{margin-top:20rpx;padding:24rpx;background:#fff;border:1rpx solid #e5efeb;border-radius:22rpx;box-shadow:0 8rpx 24rpx rgba(42,157,143,.05)}.order-head,.order-line,.order-foot{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.order-plan{color:#1a2e2b;font-size:27rpx;font-weight:800}.order-status{color:#2a9d8f;font-size:21rpx}.order-status.pending{color:#c98120}.order-status.refunded,.order-status.cancelled{color:#8f9e99}.order-line{margin-top:15rpx;color:#8f9e99;font-size:20rpx}.order-foot{margin-top:18rpx;padding-top:16rpx;border-top:1rpx solid #edf5f2;color:#60736c;font-size:22rpx}.order-amount{color:#1e6b62;font-size:29rpx;font-weight:800}.empty-state{margin-top:120rpx;color:#8f9e99;text-align:center;font-size:23rpx}
