<view class="page orders-page"><view class="page-title">我的订单</view><view class="page-caption">会员购买记录与支付状态</view><block wx:for="{{orders}}" wx:key="orderId"><view class="order-card" data-id="{{item._id || item.orderId}}" bindtap="openOrder"><view class="order-head"><view class="order-plan">{{item.planName}}</view><view class="order-status {{item.status}}">{{item.statusText}}</view></view><view class="order-line"><text>订单号</text><text>{{item.orderNo || item.orderId}}</text></view><view class="order-line"><text>下单时间</text><text>{{item.createdText}}</text></view><view class="order-foot"><text>实付</text><text class="order-amount">¥{{item.amountText}}</text></view></view></block><view wx:if="{{!orders.length}}" class="empty-state">还没有会员订单</view></view>
