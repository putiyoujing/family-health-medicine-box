<view class="page">
  <view class="page-title">
    <text class="eyebrow">图片信息整理</text>
    <view class="h1">确认后再保存</view>
  </view>

  <view class="section">
    <view class="section-title">图片类型</view>
    <picker mode="selector" range="{{kindOptions}}" range-key="label" value="{{kindIndex}}" bindchange="onKindChange">
      <view class="picker-value">{{kindLabel}}</view>
    </picker>
    <view class="muted parse-note">图片整理只提取记录信息，不替代医生的诊断、处方或剂量建议。请核对后再保存。</view>
  </view>

  <view class="safety" wx:if="{{!featureEnabled}}">图片整理暂未开放，你可以返回后手动填写记录。</view>

  <button class="primary-btn parse-action" bindtap="startParse" loading="{{parsing}}" disabled="{{parsing || !featureEnabled}}">
    {{featureEnabled ? (parsing ? '整理中' : '开始整理图片') : '图片整理暂未开放'}}
  </button>

  <view class="section" wx:if="{{task}}">
    <view class="section-title">整理结果</view>
    <view class="muted">{{task.statusText}}</view>
    <view class="field" wx:for="{{fields}}" wx:key="key">
      <text class="field-label">{{item.label}}</text>
      <input class="input" data-key="{{item.key}}" value="{{item.value}}" bindinput="onFieldInput" placeholder="{{item.placeholder}}" />
    </view>
    <button class="primary-btn" bindtap="confirmResult" loading="{{confirming}}" disabled="{{confirming}}">{{confirming ? '保存中' : '确认保存'}}</button>
  </view>

  <view class="section">
    <view class="section-title">保存前请核对</view>
    <view class="muted">整理出的内容需要由你确认，确认后才会写入家庭记录。</view>
  </view>
</view>
<global-auth-layer id="global-auth-layer" />
