.checkout-page{padding:30rpx 24rpx 50rpx}.checkout-title{color:#1a2e2b;font-size:42rpx;font-weight:800}.checkout-subtitle{margin-top:8rpx;color:#7c9089;font-size:22rpx}.checkout-card,.price-card{margin-top:22rpx;padding:26rpx;background:#fff;border:1rpx solid #e5efeb;border-radius:24rpx;box-shadow:0 8rpx 24rpx rgba(42,157,143,.04)}.summary-title,.card-title{color:#1a2e2b;font-size:28rpx;font-weight:800}.summary-price{margin-top:16rpx;color:#1e6b62;font-size:50rpx;font-weight:800}.summary-line,.check-line{margin-top:12rpx;color:#6b7c77;font-size:22rpx}.payment-row,.coupon-row,.selected-coupon,.price-card view{display:flex;justify-content:space-between;align-items:center;margin-top:18rpx;color:#60736c;font-size:22rpx}.payment-status,.coupon-link{color:#2a9d8f}.coupon-name{color:#1a2e2b;font-size:24rpx;font-weight:700}.coupon-detail{margin-top:6rpx;color:#8f9e99;font-size:20rpx}.selected-coupon>text{color:#d97706;font-size:20rpx}.price-card{background:#f7faf9}.price-card view{margin-top:0;padding:8rpx 0}.price-card text:last-child{color:#1a2e2b}.price-card .discount{color:#2a9d8f!important}.price-card .payable{margin-top:10rpx;padding-top:16rpx;border-top:1rpx solid #e5efeb;font-weight:800}.warning-card{margin-top:22rpx;padding:20rpx;color:#8a6a3f;background:#fff8e8;border-radius:18rpx;font-size:21rpx;line-height:1.6}.payment-message{margin-top:16rpx;padding:16rpx;color:#a55d26;background:#fff4e5;border-radius:14rpx;font-size:21rpx}.confirm-button{height:88rpx;margin-top:28rpx;color:#fff;background:#2a9d8f;border-radius:999rpx;font-size:27rpx;font-weight:700;line-height:88rpx}
