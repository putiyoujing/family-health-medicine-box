<view class="page membership-page">
  <view class="page-title-row"><view class="page-back" bindtap="goBack">‹</view><view class="page-title">会员中心</view><view class="profile-link" bindtap="openProfile">个人中心</view></view>
  <view class="family-row"><view class="family-name">{{family.name || '当前家庭'}}</view><button class="family-switch-button" bindtap="openFamilySwitch">切换家庭 <text>⌄</text></button></view>
  <view class="member-banner"><view><view class="banner-label">当前会员等级</view><view class="banner-title">{{entitlement.planName || '基础版'}}</view><view class="banner-copy" wx:if="{{expireText}}">有效期至 {{expireText}} · 到期后不会自动扣款</view><view class="banner-copy" wx:else>先把家人的健康记录清楚，再决定是否升级。</view></view></view>

  <view class="section usage-section"><view class="section-head"><view><view class="section-title">当前权益使用量</view><view class="section-subtitle">已使用 / 可用上限 · 基础版快速记录 3 次（累计）</view></view><view class="section-link">本家庭</view></view><view class="usage-row" wx:for="{{usageRows}}" wx:key="label"><view class="usage-label"><text>{{item.label}}</text><text class="usage-number {{item.label === '家庭数量' ? 'usage-number-warn' : ''}}">{{item.used}} / {{item.limit}}</text></view><view class="usage-track"><view class="usage-progress {{item.label === '家庭数量' ? 'usage-progress-warn' : ''}}" style="width:{{item.progress}}%;"></view></view></view></view>

  <view class="section-subtitle">家庭数量按账号统计，其他用量按当前家庭统计</view>
  <view class="section plan-section"><view class="section-head"><view class="section-title">选择会员套餐</view></view>
    <view class="period-switch"><view class="period-label">购买周期</view><button wx:for="{{periodOptions}}" wx:key="value" class="period-option {{item.value === selectedPeriod ? 'period-option-active' : ''}}" data-period="{{item.value}}" bindtap="selectPeriod">{{item.label}}</button></view>
    <view class="plan-grid"><view class="plan-card {{item.planId === selectedPlanId ? 'plan-card-selected' : ''}}" wx:for="{{planCards}}" wx:key="planId" data-plan-id="{{item.planId}}" bindtap="selectPlan"><view class="plan-topline"><view class="plan-badge">{{item.badgeLabel}}</view></view><view class="plan-name">{{item.tierLabel}}</view><view class="plan-price"><text class="currency">{{selectedPeriod === 'monthly' ? '月' : '年'}}</text> ¥{{item.priceText}}</view><view class="plan-secondary-price">{{selectedPeriod === 'monthly' ? '年' : '月'}} ¥{{selectedPeriod === 'monthly' ? item.yearlyPriceText : item.monthlyPriceText}}</view><view class="plan-benefit" wx:for="{{item.benefitItems}}" wx:for-item="benefit" wx:key="*this">• {{benefit}}</view><button class="plan-button {{item.planId === selectedPlanId ? 'plan-button-selected' : ''}}" data-plan-id="{{item.planId}}" catchtap="selectPlan">选择{{item.tierLabel}}</button></view></view>
  </view>

  <view class="section redeem-section" id="redeem-section"><view class="section-head"><view><view class="section-title">兑换会员</view><view class="section-subtitle">{{membershipPurchaseGuide}}</view></view></view><view class="redeem-form"><input value="{{redeemCode}}" placeholder="输入会员兑换码" bindinput="onRedeemInput" /><button bindtap="redeemMembershipCode" loading="{{redeeming}}" disabled="{{redeeming}}">{{redeeming ? '兑换中' : '兑换'}}</button></view><view wx:if="{{redeemResult}}" class="redeem-result">已激活 {{redeemResult.plan.name || '会员'}}，到期时间：{{redeemResult.expireAt || '以会员状态为准'}}</view></view>
  <view class="section-subtitle" wx:if="{{!paymentReady}}">{{paymentReason}}</view>
  <view class="virtual-note">会员套餐属于虚拟服务，支付完成后不支持退款；如有异常请联系后台客服处理。</view>
  <view wx:if="{{selectedPlanId}}" class="floating-purchase-bar"><button class="floating-purchase-button" disabled="{{!paymentReady || loading}}" bindtap="buySelectedPlan">{{!paymentReady ? '暂未开放 · ' : ''}}{{isUnlimitedMembership && selectedPlan.membershipTier === 'unlimited' ? '继续续费' : '购买'}}{{selectedPlan.tierLabel || '会员套餐'}} ¥{{selectedPlan.priceText || '--'}}</button></view>
</view>
<global-auth-layer id="global-auth-layer" />
