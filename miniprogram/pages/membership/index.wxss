.membership-page{padding-top:28rpx;padding-bottom:40rpx}.page-title-row,.section-head,.plan-topline,.usage-label{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.page-title{color:#1a2e2b;font-size:42rpx;font-weight:800}.page-caption,.section-subtitle{margin-top:8rpx;color:#7c9089;font-size:22rpx}.member-level,.redeem-tag{padding:10rpx 16rpx;color:#228b78;background:#e8f8f3;border-radius:999rpx;font-size:21rpx}.member-banner{display:flex;align-items:center;justify-content:space-between;margin-top:24rpx;padding:30rpx;color:#1c4e43;background:linear-gradient(135deg,#e6f7f2,#d4efe7);border-radius:28rpx;box-shadow:0 12rpx 28rpx rgba(42,157,143,.08)}.banner-label{color:#508278;font-size:22rpx}.banner-title{margin-top:10rpx;font-size:48rpx;font-weight:800}.banner-copy{margin-top:12rpx;color:#607b73;font-size:21rpx}.banner-badge{display:flex;align-items:center;justify-content:center;width:110rpx;height:110rpx;color:#2a9d8f;background:rgba(255,255,255,.58);border:6rpx solid rgba(42,157,143,.32);border-radius:50%;font-size:54rpx;font-weight:700}.section{margin-top:24rpx;padding:28rpx;background:#fff;border:1rpx solid #e5efeb;border-radius:24rpx;box-shadow:0 8rpx 24rpx rgba(42,157,143,.05)}.section-title{color:#1a2e2b;font-size:30rpx;font-weight:800}.section-link{color:#2a9d8f;font-size:20rpx}.plan-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin-top:24rpx}.plan-card{min-width:0;padding:22rpx;border:2rpx solid #d9ebe5;border-radius:22rpx;background:#fff}.plan-card-premium{border-color:#2a9d8f;background:linear-gradient(180deg,#f1fbf8,#fff)}.plan-name{color:#1a2e2b;font-size:29rpx;font-weight:800}.plan-badge{padding:5rpx 9rpx;color:#2a9d8f;background:#e8f8f3;border-radius:999rpx;font-size:17rpx}.plan-period{margin-top:14rpx;color:#60736c;font-size:22rpx}.plan-price{margin-top:5rpx;color:#1e6b62;font-size:48rpx;font-weight:800}.currency{font-size:24rpx}.plan-validity{color:#8f9e99;font-size:19rpx}.plan-benefit{margin-top:13rpx;color:#60736c;font-size:20rpx;line-height:1.25}.plan-button,.redeem-form button{height:72rpx;margin-top:24rpx;color:#1e6b62;background:#e8f8f3;border-radius:999rpx;font-size:23rpx;font-weight:700;line-height:72rpx}.plan-button-primary,.redeem-form button{color:#fff;background:#2a9d8f}.usage-row{margin-top:22rpx}.usage-label{color:#60736c;font-size:22rpx}.usage-number{color:#1e6b62;font-weight:700}.usage-track{height:10rpx;margin-top:9rpx;overflow:hidden;background:#edf5f2;border-radius:999rpx}.usage-progress{height:100%;background:#2a9d8f;border-radius:999rpx}.redeem-form{display:flex;gap:14rpx;margin-top:24rpx}.redeem-form input{flex:1;min-width:0;height:72rpx;padding:0 20rpx;color:#1a2e2b;background:#f7faf9;border:1rpx solid #dcebe6;border-radius:16rpx;font-size:23rpx}.redeem-form button{flex:0 0 180rpx;margin-top:0}.redeem-result{margin-top:18rpx;padding:16rpx;color:#228b78;background:#e8f8f3;border-radius:14rpx;font-size:21rpx}.virtual-note{margin:24rpx 8rpx 0;color:#8b9994;font-size:20rpx;line-height:1.6}
