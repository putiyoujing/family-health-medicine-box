.membership-page {
  padding-top: 32rpx;
}

.member-hero {
  position: relative;
  margin-bottom: 24rpx;
  padding: 38rpx 36rpx;
  overflow: hidden;
  color: #fff8e8;
  background: linear-gradient(140deg, #123e37 0%, #1d5f53 64%, #806b42 145%);
  border-radius: 34rpx;
  box-shadow: 0 22rpx 52rpx rgba(16, 72, 62, 0.2);
}

.hero-orbit {
  position: absolute;
  border: 1rpx solid rgba(246, 223, 170, 0.18);
  border-radius: 50%;
}

.orbit-one {
  top: -100rpx;
  right: -70rpx;
  width: 300rpx;
  height: 300rpx;
}

.orbit-two {
  top: -36rpx;
  right: -10rpx;
  width: 170rpx;
  height: 170rpx;
  background: radial-gradient(circle, rgba(246, 223, 170, 0.18), rgba(246, 223, 170, 0));
}

.hero-topline {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-label {
  color: #cce0da;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.hero-status {
  padding: 7rpx 13rpx;
  color: #5f491e;
  background: #f4dca8;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.hero-plan {
  position: relative;
  margin-top: 16rpx;
  font-family: "STSong", "Songti SC", serif;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.2;
}

.hero-slogan,
.hero-expire {
  position: relative;
  margin-top: 22rpx;
  padding-top: 20rpx;
  color: #f3dfb2;
  border-top: 1rpx solid rgba(255, 255, 255, 0.12);
  font-size: 22rpx;
}

.membership-action-card,
.usage-card {
  padding: 30rpx;
  border-radius: 30rpx;
}

.membership-action-card {
  border: 2rpx solid rgba(23, 111, 97, 0.15);
}

.membership-action-title,
.usage-title {
  align-items: flex-start;
}

.section-subtitle {
  margin-top: 5rpx;
  color: #7a8e88;
  font-size: 21rpx;
  font-weight: 400;
}

.recommend-badge,
.plan-chip {
  flex: 0 0 auto;
  padding: 8rpx 13rpx;
  color: #836020;
  background: #fff0ce;
  border-radius: 999rpx;
  font-size: 19rpx;
  font-weight: 900;
}

.comparison-table {
  margin-top: 16rpx;
  overflow: hidden;
  border: 1rpx solid #deece8;
  border-radius: 22rpx;
}

.comparison-row {
  display: grid;
  grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr) minmax(0, 1fr);
  min-height: 72rpx;
  border-top: 1rpx solid #edf4f2;
}

.comparison-row:first-child {
  border-top: 0;
}

.comparison-row text {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 8rpx;
  text-align: center;
  font-size: 21rpx;
  min-width: 0;
  overflow-wrap: anywhere;
}

.comparison-head {
  min-height: 64rpx;
  color: #587069;
  background: #eff8f5;
  font-weight: 900;
}

.comparison-label {
  color: #324b45;
  background: #fbfdfc;
  font-weight: 800;
}

.comparison-free {
  color: #71837e;
}

.comparison-pro {
  color: #176f61;
  background: #f3faf7;
  font-weight: 900;
}

.plan-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.plan-card {
  min-width: 0;
  min-height: 252rpx;
  padding: 22rpx;
  background: #f8fbfa;
  border: 1rpx solid #dfece8;
  border-radius: 22rpx;
}

.recommend-plan {
  background: linear-gradient(110deg, #f6fbf8, #fff8e8);
  border-color: #e8d8ad;
}

.plan-name-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.plan-badge {
  padding: 4rpx 9rpx;
  color: #8b641d;
  background: #f8e6b9;
  border-radius: 999rpx;
  font-size: 17rpx;
  font-weight: 900;
}

.plan-audience {
  margin-top: 16rpx;
  color: #667b75;
  font-size: 20rpx;
  line-height: 1.5;
}

.plan-price {
  margin-top: 14rpx;
  color: #176f61;
  font-size: 39rpx;
  font-weight: 900;
}

.plan-price text {
  margin-right: 2rpx;
  font-size: 21rpx;
}

.benefits-panel {
  margin-top: 26rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid #deece8;
}

.benefits-title {
  color: #18322d;
  font-size: 27rpx;
  font-weight: 900;
}

.redeem-panel {
  margin-top: 24rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid #deece8;
}

.redeem-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 22rpx;
}

.redeem-heading > view {
  min-width: 0;
}

.redeem-title {
  margin-bottom: 5rpx;
}

.redeem-mark {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  color: #806021;
  background: #fff0ce;
  border-radius: 22rpx;
  font-family: "STSong", "Songti SC", serif;
  font-size: 28rpx;
  font-weight: 900;
}

.redeem-form {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.redeem-form input {
  flex: 1;
  min-width: 0;
  height: 78rpx;
  padding: 0 20rpx;
  color: #243e38;
  background: #f5faf8;
  border: 1rpx solid #cfe4de;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.redeem-form button {
  flex: 0 0 158rpx;
  height: 78rpx;
  color: #fff8e8;
  background: #184f47;
  border-radius: 18rpx;
  font-size: 24rpx;
  font-weight: 900;
}

.redeem-result {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  color: #195b3a;
  background: #eaf7ed;
  border-radius: 16rpx;
  font-size: 23rpx;
  font-weight: 800;
}

.usage-row {
  margin-bottom: 23rpx;
}

.usage-row:last-child {
  margin-bottom: 0;
}

.usage-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 9rpx;
  color: #405a54;
  font-size: 23rpx;
  font-weight: 700;
}

.usage-number {
  color: #176f61;
  font-weight: 900;
}

.usage-track {
  height: 10rpx;
  overflow: hidden;
  background: #e8f1ee;
  border-radius: 999rpx;
}

.usage-progress {
  height: 100%;
  background: linear-gradient(90deg, #46b9a4, #e2bc6b);
  border-radius: 999rpx;
}
