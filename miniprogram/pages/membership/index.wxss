.membership-page{padding-top:28rpx;padding-bottom:188rpx}.page-title-row,.section-head,.plan-topline,.usage-label{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.page-title-row{justify-content:flex-start;margin-bottom:28rpx}.page-back{flex:0 0 40rpx;width:40rpx;color:#18322d;font-size:52rpx;line-height:34rpx}.page-title{margin:0;color:#1a2e2b;font-size:36rpx;font-weight:800;line-height:1}.profile-link{margin-left:auto;color:#607b73;font-size:22rpx}.family-row{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.family-name{color:#1a2e2b;font-size:24rpx;font-weight:800}.family-switch-button{flex:0 0 auto;width:150rpx;height:52rpx;color:#228b78;background:#e8f8f3;border-radius:999rpx;font-size:20rpx;line-height:52rpx}.family-switch-button text{margin-left:6rpx;font-size:24rpx}.member-banner{margin-top:24rpx;padding:30rpx;color:#1c4e43;background:linear-gradient(135deg,#e6f7f2,#d4efe7);border-radius:28rpx;box-shadow:0 12rpx 28rpx rgba(42,157,143,.08)}.banner-label{color:#508278;font-size:22rpx}.banner-title{margin-top:10rpx;font-size:48rpx;font-weight:800}.banner-copy{margin-top:12rpx;color:#607b73;font-size:21rpx}.section{margin-top:24rpx;padding:28rpx;background:#fff;border:1rpx solid #e5efeb;border-radius:24rpx;box-shadow:0 8rpx 24rpx rgba(42,157,143,.05)}.section-title{color:#1a2e2b;font-size:30rpx;font-weight:800}.section-subtitle{margin-top:8rpx;color:#7c9089;font-size:22rpx}.section-link{color:#2a9d8f;font-size:20rpx}.period-switch{display:flex;align-items:center;gap:12rpx;margin-top:24rpx;padding:8rpx 10rpx;background:#fff;border:1rpx solid #e5efeb;border-radius:18rpx}.period-label{flex:0 0 150rpx;padding-left:10rpx;color:#60736c;font-size:22rpx}.period-option{flex:1;height:68rpx;color:#4f766d;background:#e8f8f3;border-radius:14rpx;font-size:24rpx;font-weight:700;line-height:68rpx}.period-option-active{color:#fff;background:#165f54;box-shadow:0 8rpx 16rpx rgba(22,95,84,.18)}.plan-grid{display:grid;grid-template-colum