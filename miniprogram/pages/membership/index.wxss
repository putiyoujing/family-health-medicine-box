.member-hero {
  margin-bottom: 24rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, #eef7f1 0%, #fff6e5 100%);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(36, 53, 46, 0.06);
}

.plan-pill {
  margin-top: 18rpx;
}

.plan-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 24rpx;
  background: #ffffff;
  border: 1rpx solid rgba(63, 125, 91, 0.12);
  border-radius: 24rpx;
}

.recommend-plan {
  background: #eef7f1;
  border-color: #3f7d5b;
}

.price {
  color: #3f7d5b;
  font-size: 42rpx;
  font-weight: 800;
}

.benefit-row {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(63, 125, 91, 0.08);
}

.benefit-row:last-child {
  border-bottom: 0;
}
