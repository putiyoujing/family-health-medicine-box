.success-page{min-height:100vh;padding:64rpx 30rpx calc(40rpx + env(safe-area-inset-bottom));background:#f4fbf8}.success-card{padding:52rpx 36rpx 44rpx;text-align:center;background:#fff;border:1rpx solid #e5efeb;border-radius:28rpx;box-shadow:0 8rpx 24rpx rgba(42,157,143,.06)}.success-icon{display:flex;align-items:center;justify-content:center;width:112rpx;height:112rpx;margin:0 auto 32rpx;color:#fff;background:#2a9d8f;border-radius:50%;font-size:66rpx;font-weight:700}.success-title{color:#1a2e2b;font-size:38rpx;font-weight:800}.success-subtitle{margin-top:18rpx;color:#60736c;font-size:25rpx}.countdown{margin-top:32rpx;color:#2a9d8f;font-size:24rpx}.success-button,.secondary-button{height:88rpx;margin-top:32rpx;border-radius:999rpx;font-size:27rpx;font-weight:700}.success-button{color:#fff;background:#2a9d8f}.secondary-button{margin-top:16rpx;color:#2a9d8f;background:#e9f6f2}
