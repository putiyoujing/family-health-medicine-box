<view class="page">
  <view class="page-title">
    <text class="eyebrow">优惠券</text>
    <view class="h1">选择可用优惠</view>
  </view>

  <view class="section">
    <view class="section-title">输入优惠码</view>
    <view class="coupon-input-row">
      <input class="input" value="{{couponCode}}" bindinput="onInput" placeholder="输入优惠码" />
      <button class="primary-btn use-btn" bindtap="useInput">使用</button>
    </view>
  </view>

  <view class="section">
    <view class="section-title">可用优惠券</view>
    <view wx:if="{{!coupons.length}}" class="empty">当前没有可用优惠券</view>
    <view class="coupon-card" wx:for="{{coupons}}" wx:key="_id" data-code="{{item.code}}" bindtap="chooseCoupon">
      <view>
        <view class="record-title">{{item.name || item.code}}</view>
        <view class="muted">{{item.code}} · {{item.discountPreview}}</view>
      </view>
      <text class="pill">使用</text>
    </view>
  </view>
</view>
