.form-page {
  padding-bottom: 220rpx;
  background:
    radial-gradient(circle at 88% 2%, rgba(165, 228, 216, 0.28), transparent 34%),
    #f4fbf8;
}

.form-hero {
  margin: 12rpx 0 24rpx;
}

.hero-note {
  margin-top: 12rpx;
  color: #6f827d;
  font-size: 25rpx;
}

.section-kicker {
  margin-bottom: 20rpx;
  color: #18322d;
  font-size: 30rpx;
  font-weight: 900;
}

.picker-row,
.unit-input-shell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 88rpx;
  padding: 18rpx 24rpx;
  color: #18322d;
  background: #ffffff;
  border: 1rpx solid #cfe7e1;
  border-radius: 24rpx;
}

.member-value {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.member-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 auto;
  color: #ffffff;
  background: #259f8e;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 900;
}

.member-selection-hint {
  display: block;
  margin-top: 12rpx;
  color: #6f827d;
  font-size: 22rpx;
  line-height: 1.5;
}

.picker-arrow {
  color: #8ea19c;
  font-size: 36rpx;
  line-height: 1;
}

.date-time-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
  gap: 14rpx;
}

.date-time-grid > view {
  min-width: 0;
}

.date-time-picker {
  min-height: 88rpx;
}

.status-options {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 10rpx;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  padding: 7rpx;
  overflow: hidden;
  background: #edf7f3;
  border-radius: 24rpx;
}

.status-option {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  height: 74rpx;
  padding: 0 8rpx;
  color: #60756f;
  background: transparent;
  border: 0;
  border-radius: 18rpx;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 74rpx;
}

.status-option::after {
  border: 0;
}

.status-option-active {
  color: #174f46;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(23, 79, 70, 0.1);
}

.completed-status {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 24rpx;
  color: #60756f;
  background: #edf3f0;
  border-radius: 24rpx;
  font-size: 25rpx;
  font-weight: 800;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.tag {
  padding: 10rpx 17rpx;
  color: #48665f;
  background: #eef9f5;
  border: 1rpx solid #c9e9e1;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.tag-selected {
  color: #ffffff;
  background: #259f8e;
  border-color: #259f8e;
}

.recent-row {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed #d6eae5;
}

.recent-label {
  color: #788c87;
  font-size: 22rpx;
  font-weight: 700;
}

.recent-tags {
  margin-top: 10rpx;
}

.subtle-tag {
  background: #ffffff;
}

.unit-input-shell {
  gap: 8rpx;
  padding-right: 22rpx;
}

.unit-input {
  width: 100%;
  min-width: 0;
}

.unit-suffix {
  color: #355d55;
  font-size: 28rpx;
  font-weight: 900;
}

.vital-grid {
  display: grid;
  grid-template-columns: 100%;
  align-items: start;
}

.vital-grid > .field {
  min-width: 0;
}

.textarea {
  border-radius: 24rpx;
}

.diagnosis-textarea {
  min-height: 204rpx;
}

.last-field {
  margin-bottom: 0;
}

.visit-section {
  border-color: #cce8e1;
}

.attachment-section {
  display: grid;
  gap: 20rpx;
  padding-top: 24rpx;
  border-top: 1rpx dashed #cfe3dc;
}

.attachment-title {
  color: #18322d;
  font-size: 28rpx;
  font-weight: 900;
}

.attachment-btn {
  width: 100%;
}

.attachment-ready {
  padding: 16rpx 20rpx;
  color: #174f46;
  background: #e5f8f2;
  border-radius: 16rpx;
  font-size: 23rpx;
}

.attachment-preview-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.attachment-preview {
  position: relative;
  overflow: hidden;
  aspect-ratio: 1;
  border-radius: 14rpx;
}

.attachment-preview image {
  width: 100%;
  height: 100%;
}

.attachment-remove {
  position: absolute;
  right: 6rpx;
  bottom: 6rpx;
  width: 72rpx;
  height: 40rpx;
  padding: 0;
  color: #ffffff;
  background: rgba(88, 43, 37, 0.82);
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 40rpx;
}

.attachment-remove::after {
  border: 0;
}

.prescription-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 24rpx;
}

.prescription-head > view {
  min-width: 0;
}

.add-medicine-btn {
  width: 160rpx;
  height: 56rpx;
  flex: none;
  font-size: 22rpx;
}

.visit-medicine-list {
  display: grid;
  gap: 12rpx;
  margin-top: 18rpx;
}

.visit-medicine-item {
  padding: 18rpx;
  background: #ffffff;
  border: 1rpx solid #d7e2dc;
  border-radius: 16rpx;
}

.prescription-empty {
  padding: 22rpx 0 0;
}

.save-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  padding: 22rpx 32rpx calc(22rpx + env(safe-area-inset-bottom));
  background: rgba(244, 251, 248, 0.96);
  border-top: 1rpx solid rgba(207, 231, 225, 0.9);
  box-shadow: 0 -18rpx 40rpx rgba(10, 36, 28, 0.08);
}

.save-btn {
  width: 100%;
}
