.action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.action-grid .primary-btn,
.action-grid .ghost-btn {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  height: 76rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.detail-line {
  margin-top: 12rpx;
}

.event-type-options {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  padding: 8rpx;
  background: #edf7f3;
  border: 1rpx solid #d9ebe5;
  border-radius: 24rpx;
}

.event-type-option {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  height: 74rpx;
  padding: 0;
  color: #6b8079;
  background: transparent;
  border-radius: 18rpx;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 74rpx;
  white-space: normal;
}

.event-type-option::after {
  border: 0;
}

.event-type-option-active {
  color: #174f46;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(23, 79, 70, 0.1);
}

.symptom-textarea {
  min-height: 160rpx;
}

.temperature-input-shell {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 88rpx;
  padding: 0 28rpx;
  background: #ffffff;
  border: 1rpx solid #cfe7e1;
  border-radius: 24rpx;
}

.temperature-input {
  flex: 1 1 0;
  min-width: 0;
  height: 86rpx;
}

.temperature-unit {
  flex: none;
  color: #35534c;
  font-size: 28rpx;
}

.timeline {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.timeline-item {
  display: grid;
  grid-template-columns: 28rpx minmax(0, 1fr);
  gap: 14rpx;
}

.timeline-dot {
  width: 18rpx;
  height: 18rpx;
  margin-top: 10rpx;
  background: #2f7d57;
  border-radius: 50%;
}

.timeline-content {
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #dce4dd;
}

.illness-todo-list {
  display: grid;
  gap: 14rpx;
}

.illness-todo {
  padding: 20rpx;
  background: #f4faf7;
  border: 1rpx solid #d7e8e0;
  border-radius: 18rpx;
}

.illness-todo-completed {
  opacity: 0.62;
}

.todo-state {
  flex: none;
  color: #257b69;
  font-size: 22rpx;
  font-weight: 800;
}

.todo-note {
  margin-top: 10rpx;
  overflow: hidden;
  color: #40554f;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.illness-todo-actions {
  display: flex;
  gap: 10rpx;
  margin-top: 18rpx;
}

.illness-todo-action {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  height: 56rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 56rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.illness-todo-action::after {
  border: 0;
}

.illness-todo-action.edit-action {
  color: #1c7061;
  background: #e5f5ef;
}

.illness-todo-action.complete-action {
  color: #ffffff;
  background: #257b69;
}

.illness-todo-action.delete-action {
  color: #a63b32;
  background: #fff0ec;
}

.timeline-head {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.check-list {
  display: grid;
  gap: 12rpx;
  color: #1d2722;
}

.prescription-panel {
  margin-bottom: 24rpx;
  padding: 22rpx;
  background: #f3f8f5;
  border: 1rpx solid #d4e5dc;
  border-radius: 20rpx;
}

.attachment-section {
  display: grid;
  gap: 14rpx;
  margin-bottom: 24rpx;
  padding: 20rpx;
  background: #ffffff;
  border: 1rpx solid #d7e2dc;
  border-radius: 16rpx;
}

.attachment-title {
  color: #1d2722;
  font-size: 25rpx;
  font-weight: 800;
}

.attachment-btn {
  width: 100%;
}

.attachment-ready {
  color: #257b69;
  font-size: 23rpx;
}

.attachment-preview-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.attachment-preview {
  position: relative;
  overflow: hidden;
  aspect-ratio: 1;
  border-radius: 14rpx;
}

.attachment-preview image {
  width: 100%;
  height: 100%;
}

.attachment-remove {
  position: absolute;
  right: 6rpx;
  bottom: 6rpx;
  width: 72rpx;
  height: 40rpx;
  padding: 0;
  color: #ffffff;
  background: rgba(88, 43, 37, 0.82);
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 40rpx;
}

.attachment-remove::after {
  border: 0;
}

.prescription-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.prescription-head > view,
.timeline-head > text:first-child,
.completion-section > view,
.danger-section > view {
  min-width: 0;
}

.add-medicine-btn {
  width: 144rpx;
  height: 56rpx;
  flex: none;
  font-size: 22rpx;
}

.visit-medicine-list {
  display: grid;
  gap: 12rpx;
}

.visit-medicine-item {
  padding: 18rpx;
  background: #ffffff;
  border: 1rpx solid #d7e2dc;
  border-radius: 16rpx;
}

.prescription-empty {
  padding: 22rpx;
}

.course-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin: 28rpx 0 36rpx;
}

.completion-section {
  margin-top: 28rpx;
}

.completion-textarea {
  min-height: 180rpx;
}

.completion-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.completion-actions button {
  width: 100%;
  min-width: 0;
}

.cancel-completion-btn {
  height: 76rpx;
  padding: 0 12rpx;
  color: #176f61;
  background: #e3f6ef;
  border: 1rpx solid #b9e5d8;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 76rpx;
}

.close-course-btn,
.delete-record-btn {
  width: 100%;
  min-width: 0;
  height: 76rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 76rpx;
  white-space: nowrap;
}

.close-course-btn {
  color: #ffffff;
  background: #257b69;
}

.close-course-btn::after {
  border: 0;
}

.delete-record-btn {
  color: #a63b32;
  background: #fff0ec;
  border: 1rpx solid #efc9c0;
}
