<view class="page">
  <view class="page-title">
    <view class="h1">家人的病程记录</view>
    <view class="page-subtitle">按时间查看症状、体温、就诊和恢复过程</view>
  </view>

  <button class="primary-btn add-btn" wx:if="{{showWriteEntries}}" loading="{{loading}}" disabled="{{loading}}" bindtap="createRecord">记一次生病</button>

  <view class="card-list">
    <view class="list-heading" wx:if="{{records.length}}">
      <text>全部病程</text>
      <text class="muted">{{records.length}} 次</text>
    </view>
    <view wx:if="{{!records.length}}" class="empty">还没有病程记录</view>
    <view class="record-card {{item.completed ? 'record-card-completed' : ''}}" wx:for="{{records}}" wx:key="_id">
      <view class="record-main" data-id="{{item._id}}" bindtap="openDetail">
        <view class="record-head">
          <view>
            <view class="record-title">{{item.memberName}} · {{item.symptomText}}</view>
            <view class="muted">{{item.timeText}}</view>
          </view>
          <text class="pill">{{item.statusText}}</text>
        </view>
        <view>{{item.summary || item.symptomDescription || '暂无总结'}}</view>
        <view class="muted">最高体温：{{item.temperatureText}} · 医嘱：{{item.doctorAdvice || '未记录'}}</view>
      </view>
      <view class="card-actions" wx:if="{{showWriteEntries}}">
        <button class="append-btn" wx:if="{{!item.completed}}" data-id="{{item._id}}" bindtap="appendRecord">追加记录</button>
        <button class="ghost-btn edit-btn" data-id="{{item._id}}" bindtap="editRecord">修改</button>
        <button class="ghost-btn mini-btn" data-id="{{item._id}}" bindtap="quickSimilar">再记一条相似的</button>
      </view>
    </view>
    <view class="list-end" wx:if="{{records.length}}">到底了哦</view>
  </view>
</view>
<global-auth-layer id="global-auth-layer" />
