.quick-input {
  min-height: 220rpx;
}

.quick-ai-hint {
  margin-top: 16rpx;
  line-height: 1.6;
}

.quick-quota-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 22rpx;
  padding: 22rpx 24rpx;
  color: #27574e;
  background: linear-gradient(135deg, #effaf5, #fff8e8);
  border: 1rpx solid #d5ebe2;
  border-radius: 22rpx;
}

.quick-quota-title {
  font-size: 25rpx;
  font-weight: 900;
}

.quick-quota-text {
  margin-top: 6rpx;
  color: #71837e;
  font-size: 22rpx;
}

.quick-quota-count {
  flex: 0 0 auto;
  padding: 8rpx 12rpx;
  color: #9a671e;
  background: #fff0ce;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 900;
}

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 88rpx;
  padding: 18rpx 24rpx;
  color: #18322d;
  background: #ffffff;
  border: 1rpx solid #cfe7e1;
  border-radius: 24rpx;
}

.member-value {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.member-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 auto;
  color: #ffffff;
  background: #259f8e;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 900;
}

.picker-arrow {
  color: #8ea19c;
  font-size: 36rpx;
  line-height: 1;
}

.quick-upload-note {
  margin-top: 12rpx;
}

.quick-upload-card {
  margin-top: 18rpx;
  padding: 22rpx;
  border: 1rpx solid #e0eee9;
  border-radius: 22rpx;
  background: #fbfefd;
}

.quick-upload-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.quick-upload-btn {
  min-width: 120rpx;
  flex: 0 0 auto;
}

.quick-empty {
  margin-top: 18rpx;
  color: #91a7a1;
  font-size: 24rpx;
}

.attachment-preview-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.attachment-preview {
  position: relative;
  overflow: hidden;
  aspect-ratio: 1;
  border-radius: 14rpx;
  background: #edf5f2;
}

.attachment-preview image {
  width: 100%;
  height: 100%;
}

.attachment-remove-top {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  z-index: 1;
  width: 42rpx;
  height: 42rpx;
  margin: 0;
  padding: 0;
  color: #ffffff;
  background: rgba(52, 69, 64, 0.82);
  border: 0;
  border-radius: 50%;
  font-size: 34rpx;
  line-height: 38rpx;
}

.attachment-remove-top::after {
  border: 0;
}

.image-preview-modal {
  position: fixed;
  z-index: 200;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(13, 24, 21, 0.96);
}

.image-preview-large {
  width: 100%;
  height: 78%;
}

.image-preview-close {
  position: absolute;
  z-index: 2;
  top: calc(28rpx + env(safe-area-inset-top));
  right: 30rpx;
  width: 64rpx;
  height: 64rpx;
  color: #ffffff;
  font-size: 56rpx;
  line-height: 58rpx;
  text-align: center;
}

.image-preview-actions {
  position: absolute;
  right: 32rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  left: 32rpx;
  display: flex;
  gap: 18rpx;
}

.image-preview-actions button {
  flex: 1;
  height: 78rpx;
  margin: 0;
  border-radius: 999rpx;
  font-size: 27rpx;
}

.image-preview-delete {
  color: #ffffff;
  background: #bd5d55;
}

.image-preview-cancel {
  color: #24443d;
  background: #ffffff;
}

.quick-submit {
  margin: 28rpx 0 40rpx;
}

.quick-lock-layer {
  position: fixed;
  z-index: 180;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(24, 50, 45, 0.56);
}

.quick-lock-card {
  width: 100%;
  padding: 52rpx 38rpx 38rpx;
  text-align: center;
  background: #fffdf6;
  border-radius: 30rpx;
  box-shadow: 0 24rpx 64rpx rgba(23, 63, 54, 0.22);
}

.quick-lock-icon {
  color: #c18a32;
  font-size: 64rpx;
  font-weight: 900;
  line-height: 1;
}

.quick-lock-title {
  margin-top: 22rpx;
  color: #18322d;
  font-size: 32rpx;
  font-weight: 900;
}

.quick-lock-text {
  margin-top: 12rpx;
  color: #71837e;
  font-size: 25rpx;
}

.quick-lock-btn {
  margin: 32rpx 0 0;
}
