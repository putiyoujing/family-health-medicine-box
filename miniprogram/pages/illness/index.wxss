.illness-entry-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.illness-entry-actions .add-btn,
.illness-entry-actions .quick-add-btn {
  flex: 0 1 260rpx;
  width: 260rpx;
  max-width: calc((100% - 16rpx) / 2);
  min-width: 0;
  height: 76rpx;
  padding: 0 18rpx;
  margin-bottom: 0;
  color: #ffffff;
  background: #259f8e;
  border-color: #259f8e;
  border-radius: 999rpx;
  box-shadow: 0 10rpx 24rpx rgba(10, 36, 28, 0.12);
  font-size: 24rpx;
}

.add-btn {
  background: #259f8e;
}

.page-subtitle {
  margin-top: 12rpx;
  color: #6f827d;
  font-size: 25rpx;
}

.list-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx;
  color: #18322d;
  font-size: 30rpx;
  font-weight: 900;
}

.card-actions {
  display: flex;
  flex-wrap: nowrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.card-actions .append-btn,
.card-actions .edit-btn,
.card-actions .mini-btn {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  max-width: none;
  padding: 0 4rpx;
  overflow: hidden;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-card-completed {
  background: #f8faf9;
  border-color: #dce6e1;
  box-shadow: none;
}

.mini-btn {
  height: 56rpx;
}

.edit-btn {
  height: 56rpx;
  color: #174f46;
}

.append-btn {
  height: 56rpx;
  color: #ffffff;
  background: #257b69;
  font-weight: 800;
}
