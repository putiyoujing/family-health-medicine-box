<view class="page">
  <view class="page-title">
    <text class="eyebrow">运营管理后台</text>
    <view class="h1">数据统计</view>
    <view class="muted">更新时间：{{generatedAt || '未加载'}}</view>
  </view>

  <view wx:if="{{!hasPermission}}" class="section">
    <view class="section-title">暂无管理权限</view>
    <view class="muted">请先在云数据库 `admins` 集合中添加当前 openid，并设置 status=active。</view>
  </view>

  <block wx:else>
    <view class="admin-grid">
      <view class="admin-stat">
        <text>用户</text>
        <view>{{stats.users || 0}}</view>
      </view>
      <view class="admin-stat">
        <text>家庭</text>
        <view>{{stats.families || 0}}</view>
      </view>
      <view class="admin-stat">
        <text>成员</text>
        <view>{{stats.members || 0}}</view>
      </view>
      <view class="admin-stat">
        <text>药品</text>
        <view>{{stats.medicines || 0}}</view>
      </view>
      <view class="admin-stat">
        <text>健康记录</text>
        <view>{{stats.illnessRecords || 0}}</view>
      </view>
      <view class="admin-stat">
        <text>用药记录</text>
        <view>{{stats.medicationLogs || 0}}</view>
      </view>
      <view class="admin-stat">
        <text>附件</text>
        <view>{{stats.attachments || 0}}</view>
      </view>
      <view class="admin-stat">
        <text>提醒</text>
        <view>{{stats.reminders || 0}}</view>
      </view>
      <view class="admin-stat">
        <text>订单</text>
        <view>{{stats.orders || 0}}</view>
      </view>
      <view class="admin-stat">
        <text>会员家庭</text>
        <view>{{stats.activeSubscriptions || 0}}</view>
      </view>
      <view class="admin-stat">
        <text>优惠券</text>
        <view>{{stats.coupons || 0}}</view>
      </view>
      <view class="admin-stat">
        <text>AI 用量</text>
        <view>{{stats.aiUsageLogs || 0}}</view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">运营中心</view>
      <view class="ops-grid">
        <view class="ops-card revenue-card">
          <text>会员收入</text>
          <view>{{revenue.revenueText || '¥0'}}</view>
          <text>客单价 {{revenue.averageOrderText || '¥0'}}，优惠 {{revenue.discountText || '¥0'}}</text>
        </view>
        <view class="ops-card">
          <text>付费订单</text>
          <view>{{membership.paidOrders || 0}}</view>
          <text>待支付 {{membership.pendingOrders || 0}}</text>
        </view>
        <view class="ops-card">
          <text>优惠券核销</text>
          <view>{{stats.couponRedemptions || 0}}</view>
          <text>券池 {{stats.coupons || 0}}</text>
        </view>
        <view class="ops-card">
          <text>AI 用量</text>
          <view>{{aiUsage.total || 0}}</view>
          <text>问答 {{aiUsage.assistantQuery || 0}}，图片 {{aiUsage.imageParse || 0}}</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">风险关注</view>
      <view class="risk-row">
        <text>快过期药品</text>
        <text class="pill warn-pill">{{risk.expiringMedicines || 0}}</text>
      </view>
      <view class="risk-row">
        <text>低库存药品</text>
        <text class="pill danger-pill">{{risk.lowStockMedicines || 0}}</text>
      </view>
      <view class="risk-row">
        <text>成员档案缺口</text>
        <text class="pill warn-pill">{{risk.missingProfileMembers || 0}}</text>
      </view>
      <view class="risk-row">
        <text>待 OCR 附件</text>
        <text class="pill warn-pill">{{risk.pendingOcrAttachments || 0}}</text>
      </view>
    </view>

    <view class="section">
      <view class="section-title">运营健康度</view>
      <view class="health-grid">
        <view class="health-card">
          <text>户均成员</text>
          <view>{{health.averageMembersPerFamily || 0}}</view>
        </view>
        <view class="health-card">
          <text>户均药品</text>
          <view>{{health.averageMedicinesPerFamily || 0}}</view>
        </view>
        <view class="health-card">
          <text>户均健康记录</text>
          <view>{{health.averageIllnessPerFamily || 0}}</view>
        </view>
        <view class="health-card">
          <text>用药/健康记录</text>
          <view>{{health.averageMedicationPerIllness || 0}}</view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">7 天趋势</view>
      <view class="trend-card" wx:for="{{trendCards}}" wx:key="label">
        <view class="trend-head">
          <text>{{item.label}}</text>
          <text class="pill">{{item.total}}</text>
        </view>
        <view class="trend-bars">
          <view class="trend-item" wx:for="{{item.bars}}" wx:key="date">
            <view class="bar" style="height: {{item.height}}rpx;"></view>
            <text>{{item.date}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">最近用户</view>
      <view class="record-card" wx:for="{{recentUsers}}" wx:key="_id">
        <view class="record-title">{{item.title}}</view>
        <view class="muted">{{item.subtitle}}</view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">数据列表</view>
      <view class="tabs">
        <button class="tab {{activeList === 'users' ? 'active' : ''}}" data-type="users" bindtap="switchList">用户</button>
        <button class="tab {{activeList === 'families' ? 'active' : ''}}" data-type="families" bindtap="switchList">家庭</button>
        <button class="tab {{activeList === 'orders' ? 'active' : ''}}" data-type="orders" bindtap="switchList">订单</button>
        <button class="tab {{activeList === 'subscriptions' ? 'active' : ''}}" data-type="subscriptions" bindtap="switchList">会员家庭</button>
        <button class="tab {{activeList === 'coupons' ? 'active' : ''}}" data-type="coupons" bindtap="switchList">优惠券</button>
        <button class="tab {{activeList === 'aiUsage' ? 'active' : ''}}" data-type="aiUsage" bindtap="switchList">AI 用量</button>
        <button class="tab {{activeList === 'medicines' ? 'active' : ''}}" data-type="medicines" bindtap="switchList">药品</button>
        <button class="tab {{activeList === 'illness' ? 'active' : ''}}" data-type="illness" bindtap="switchList">健康</button>
        <button class="tab {{activeList === 'medication' ? 'active' : ''}}" data-type="medication" bindtap="switchList">用药</button>
        <button class="tab {{activeList === 'attachments' ? 'active' : ''}}" data-type="attachments" bindtap="switchList">附件</button>
      </view>
      <view class="list-title">{{listTitle}}</view>
      <view class="record-card" wx:for="{{list}}" wx:key="id">
        <view class="record-head">
          <view>
            <view class="record-title">{{item.title}}</view>
            <view class="muted">{{item.subtitle}}</view>
          </view>
          <text class="pill">{{item.tag}}</text>
        </view>
      </view>
      <view wx:if="{{!list.length}}" class="empty">暂无数据</view>
    </view>
  </block>
</view>
