.admin-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.admin-stat {
  padding: 24rpx;
  background: #ffffff;
  border: 1rpx solid #dce4dd;
  border-radius: 16rpx;
}

.admin-stat text {
  color: #66726c;
  font-size: 24rpx;
}

.admin-stat view {
  margin-top: 12rpx;
  color: #102018;
  font-size: 44rpx;
  font-weight: 800;
}

.ops-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.ops-card {
  display: grid;
  gap: 8rpx;
  padding: 20rpx;
  background: #eef4ef;
  border-radius: 16rpx;
}

.ops-card text {
  color: #66726c;
  font-size: 22rpx;
}

.ops-card view {
  color: #102018;
  font-size: 38rpx;
  font-weight: 800;
}

.revenue-card {
  background: #24352e;
}

.revenue-card text {
  color: #d8f2de;
}

.revenue-card view {
  color: #ffffff;
}

.risk-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #dce4dd;
}

.risk-row:last-child {
  border-bottom: 0;
}

.health-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.health-card {
  padding: 18rpx;
  background: #eef4ef;
  border-radius: 14rpx;
}

.health-card text {
  color: #66726c;
  font-size: 22rpx;
}

.health-card view {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.trend-card {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #dce4dd;
}

.trend-card:last-child {
  border-bottom: 0;
}

.trend-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  font-weight: 800;
}

.trend-bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 110rpx;
  gap: 8rpx;
}

.trend-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
}

.bar {
  width: 100%;
  min-height: 8rpx;
  background: #2f7d57;
  border-radius: 999rpx 999rpx 0 0;
}

.trend-item text {
  color: #66726c;
  font-size: 20rpx;
}

.tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.tab {
  width: auto;
  height: 58rpx;
  padding: 0 18rpx;
  color: #66726c;
  background: #eef4ef;
  font-size: 24rpx;
}

.tab.active {
  color: #ffffff;
  background: #2f7d57;
}

.list-title {
  margin: 18rpx 0;
  font-size: 30rpx;
  font-weight: 800;
}
