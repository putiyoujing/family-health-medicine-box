<view class="page">
  <view class="section filter-section" wx:if="{{!loading}}">
    <input class="input search-input" placeholder="搜索药品、成员、病程或反应" value="{{query}}" bindinput="onSearch" />
    <view class="filter-row">
      <picker class="member-filter" mode="selector" range="{{memberFilterOptions}}" range-key="name" value="{{memberFilterIndex}}" bindchange="onMemberFilterChange">
        <view class="picker-value compact-picker">{{selectedMemberFilterName}}</view>
      </picker>
      <text class="clear-filter" wx:if="{{query || memberFilterIndex}}" bindtap="clearFilters">清除筛选</text>
    </view>
  </view>

  <block wx:if="{{!loading}}">
    <button wx:if="{{!loggedIn || canEdit}}" class="primary-btn add-btn" bindtap="createMedication">记录一次用药</button>
  </block>

  <view class="loading-state" wx:if="{{loading}}">正在读取用药记录…</view>
  <view class="card-list" wx:else>
    <view class="list-heading" wx:if="{{filteredLogs.length}}">
      <text>全部记录</text>
      <text class="muted">{{filteredLogs.length}} 条</text>
    </view>
    <view wx:if="{{!filteredLogs.length}}" class="empty">
      {{logs.length ? '没有符合筛选条件的记录' : '还没有用药记录'}}
    </view>
    <view class="record-card {{item.isVoided ? 'voided-record' : ''}}" wx:for="{{filteredLogs}}" wx:key="_id">
      <view class="record-head">
        <view class="record-main">
          <view class="record-title">{{item.medicineName}}</view>
          <view class="muted">{{item.memberName}} · {{item.timeText}}</view>
        </view>
        <text class="pill {{item.isVoided ? 'voided-pill' : 'stock-pill'}}">{{item.stockText}}</text>
      </view>
      <view class="dose-line">本次服用：{{item.doseQuantity}}{{item.doseUnit}}</view>
      <view class="muted illness-line">{{item.illnessName}}</view>
      <view class="record-detail"><text>用药后反应：</text>{{item.reaction || '未填写'}}</view>
      <view class="record-detail note-clamp" wx:if="{{item.note}}"><text>备注：</text>{{item.note}}</view>
      <view class="voided-note" wx:if="{{item.isVoided}}">{{item.statusText}}</view>
      <view class="card-actions" wx:if="{{canEdit && !item.isVoided}}">
        <button class="ghost-btn edit-btn" data-id="{{item._id}}" catchtap="editMedication">修改</button>
        <text class="void-action" data-id="{{item._id}}" catchtap="voidMedication">作废</text>
      </view>
    </view>
    <view class="list-end" wx:if="{{filteredLogs.length}}">到底了哦</view>
  </view>
</view>
<global-auth-layer id="global-auth-layer" />
