<view class="page form-page">
  <view class="loading-state" wx:if="{{loading}}">正在准备用药信息…</view>
  <view class="section load-error" wx:elif="{{loadError}}"><view>{{loadError}}</view><button class="primary-btn load-error-action" bindtap="goAddMedicine">去添加药品</button></view>
  <block wx:else>
    <view class="form-hero"><text class="eyebrow">{{isEditing ? '修正用药记录' : '一次记录多种药品'}}</text><view class="h1">{{isEditing ? '修改这次用药' : '记下这次服药'}}</view><view class="hero-note">{{isEditing ? '保存时只会计算前后剂量差额。' : '搜索并勾选本次服用的药品，再分别填写剂量；每种药会生成一条记录并同步扣减库存。'}}</view></view>
    <view class="section"><view class="section-kicker">用药对象</view>
      <view class="field"><text class="field-label">家庭成员 *</text><picker mode="selector" range="{{members}}" range-key="name" value="{{memberIndex}}" bindchange="onMemberChange"><view class="picker-row {{errors.memberId ? 'field-control-error' : ''}}"><text>{{selectedMemberName}}</text><text class="picker-arrow">›</text></view></picker><view class="field-error" wx:if="{{errors.memberId}}">{{errors.memberId}}</view></view>
      <view class="field last-field"><text class="field-label">关联病程（可选）</text><picker mode="selector" range="{{illnessOptions}}" range-key="pickerLabel" value="{{illnessIndex}}" bindchange="onIllnessChange"><view class="picker-row"><text>{{selectedIllnessName}}</text><text class="picker-arrow">›</text></view></picker><view class="field-hint">只显示当前成员的病程；不关联也可以正常记录。</view></view>
    </view>
    <view class="section" wx:if="{{isEditing}}"><view class="section-kicker">本次服用</view><view class="field"><text class="field-label">药品 *</text><picker mode="selector" range="{{medicineOptions}}" range-key="name" value="{{medicineIndex}}" bindchange="onMedicineChange"><view class="picker-row {{errors.medicineId ? 'field-control-error' : ''}}"><text>{{selectedMedicineName}}</text><text class="picker-arrow">›</text></view></picker><view class="stock-hint">当前库存 {{selectedMedicineRemaining}}{{selectedMedicineUnit || '（未填写单位）'}}；本次最多可记 {{availableQuantity}}{{selectedMedicineUnit}}</view></view><view class="field last-field"><text class="field-label">本次剂量 *</text><view class="unit-input-shell {{errors.doseQuantity ? 'field-control-error' : ''}}"><input class="unit-input" data-field="doseQuantity" value="{{form.doseQuantity}}" bindinput="onInput" type="digit" placeholder="请输入实际服用量"/><text class="unit-suffix">{{selectedMedicineUnit || '待补单位'}}</text></view><view class="field-error" wx:if="{{errors.doseQuantity}}">{{errors.doseQuantity}}</view></view></view>
    <view class="section" wx:else><view class="section-kicker">本次服用的药品</view><input class="input medicine-search" placeholder="搜索药品名称或规格" value="{{medicineSearch}}" bindinput="onMedicineSearch"/><view class="medicine-picker-list"><view class="medicine-option {{item.isSelected ? 'medicine-option-selected' : ''}}" wx:for="{{filteredMedicineOptions}}" wx:key="_id" data-id="{{item._id}}" bindtap="toggleMedicine"><view><view class="medicine-option-name">{{item.name}}</view><view class="muted">库存 {{item.remainingText}}</view></view><text class="medicine-check">{{item.isSelected ? '已选' : '选择'}}</text></view></view><view class="field-error" wx:if="{{errors.medicines}}">{{errors.medicines}}</view><view class="dose-entry" wx:for="{{medicationEntries}}" wx:key="medicineId"><view class="dose-entry-head"><text>{{item.name}}</text><text class="muted">可用 {{item.availableQuantity}}{{item.unit || '（未填单位）'}}</text></view><view class="unit-input-shell {{item.error ? 'field-control-error' : ''}}"><input class="unit-input" data-index="{{index}}" value="{{item.doseQuantity}}" bindinput="onDoseInput" type="digit" placeholder="填写本次剂量"/><text class="unit-suffix">{{item.unit || '待补单位'}}</text></view><view class="field-error" wx:if="{{item.error}}">{{item.error}}</view></view><view class="field-error" wx:if="{{errors.doseQuantity}}">{{errors.doseQuantity}}</view></view>
    <view class="section"><view class="section-kicker">服用时间与记录</view><view class="field"><text class="field-label">实际服用时间 *</text><view class="date-time-grid {{errors.takenAt ? 'field-control-error-grid' : ''}}"><picker mode="date" value="{{recordDate}}" end="{{today}}" bindchange="onDateChange"><view class="picker-row"><text>{{recordDate}}</text><text class="picker-arrow">›</text></view></picker><picker mode="time" value="{{recordTime}}" bindchange="onTimeChange"><view class="picker-row"><text>{{recordTime}}</text><text class="picker-arrow">›</text></view></picker></view><view class="field-error" wx:if="{{errors.takenAt}}">{{errors.takenAt}}</view></view><view class="field"><text class="field-label">用药后反应</text><textarea class="textarea" data-field="reaction" value="{{form.reaction}}" bindinput="onInput" placeholder="例如：症状缓解、出现困倦；不填表示未记录"></textarea></view><view class="field last-field"><text class="field-label">备注</text><textarea class="textarea" data-field="note" value="{{form.note}}" bindinput="onInput" placeholder="医嘱来源、服用方式或其他需保留的信息"></textarea></view></view>
    <view class="save-bar"><button class="primary-btn save-btn" loading="{{saving}}" disabled="{{saving}}" bindtap="save">{{isEditing ? '保存修改并调整库存' : (medicationEntries.length ? '保存记录并扣减库存' : '选择药品后保存')}}</button></view>
  </block>
</view>
