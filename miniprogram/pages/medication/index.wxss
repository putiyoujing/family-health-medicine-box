.add-btn {
  margin-bottom: 24rpx;
}

.filter-section {
  padding: 24rpx;
}

.search-input {
  min-height: 80rpx;
}

.filter-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 18rpx;
}

.member-filter {
  flex: 1;
}

.compact-picker {
  min-height: 72rpx;
  padding: 14rpx 22rpx;
}

.clear-filter {
  flex: 0 0 auto;
  color: #178575;
  font-size: 24rpx;
  font-weight: 700;
}

.record-main {
  min-width: 0;
}

.stock-pill {
  flex: 0 0 auto;
}

.dose-line {
  margin-top: 16rpx;
  color: #18322d;
  font-weight: 800;
}

.illness-line {
  margin-top: 8rpx;
}

.record-detail {
  margin-top: 14rpx;
  color: #4f6660;
  line-height: 1.55;
}

.record-detail text {
  color: #18322d;
  font-weight: 700;
}

.note-clamp {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.card-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 22rpx;
}

.edit-btn,
.delete-btn {
  flex: 1 1 128rpx;
  min-width: 0;
  margin: 0;
}

.void-action {
  flex: 0 0 auto;
  padding: 18rpx 12rpx;
  color: #9a625e;
  font-size: 24rpx;
  font-weight: 700;
}

.voided-record {
  opacity: .72;
  background: #fbfbfb;
}

.voided-pill {
  color: #716c6b;
  background: #f1efee;
  border-color: #e0dcda;
}

.voided-note {
  margin-top: 14rpx;
  color: #69716e;
  font-size: 24rpx;
}
