.page {
  padding-bottom: 132rpx;
}

.dashboard-page {
  min-height: 100vh;
  background: #f4fbf8;
}

.default-home {
  min-height: calc(100vh - 56rpx);
  padding: 8rpx 0 132rpx;
  background: #f4fbf8;
}

.default-brand {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin: 20rpx 0 32rpx;
}

.default-title {
  color: #18322d;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.05;
}

.default-subtitle {
  margin-top: 4rpx;
  color: #6c807a;
  font-size: 22rpx;
  line-height: 1.3;
}

.mini-menu {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  width: 94rpx;
  height: 48rpx;
  margin-top: 2rpx;
  background: #ffffff;
  border: 1rpx solid #d8e9e4;
  border-radius: 999rpx;
}

.mini-menu text {
  width: 6rpx;
  height: 6rpx;
  background: #51645f;
  border-radius: 50%;
}

.default-hero {
  display: flex;
  align-items: flex-start;
  gap: 34rpx;
  min-height: 348rpx;
  margin: 0 0 32rpx;
  padding: 68rpx 36rpx 44rpx;
  background: #ddf7f0;
  border-radius: 56rpx;
}

.hero-mark {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  height: 108rpx;
  color: #ffffff;
  background: #ffffff;
  border: 1rpx solid #9fddd2;
  border-radius: 50%;
}

.hero-mark view,
.loading-mark {
  width: 48rpx;
  height: 48rpx;
  background: #68cfc1;
  border-radius: 50%;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.hero-title {
  color: #18322d;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.22;
}

.hero-desc {
  margin-top: 20rpx;
  color: #5f746f;
  font-size: 26rpx;
  line-height: 1.65;
}

.default-primary,
.default-secondary {
  width: 100%;
  height: 92rpx;
  margin: 0 auto;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.default-primary {
  color: #ffffff;
  background: #259f8e;
  box-shadow: 0 18rpx 30rpx rgba(37, 159, 142, 0.18);
}

.default-secondary {
  margin-top: 28rpx;
  color: #137c70;
  background: #ffffff;
  border: 1rpx solid #cde4dd;
}

.starter-card {
  margin: 40rpx 0 0;
  padding: 38rpx 34rpx 54rpx;
  background: #ffffff;
  border: 1rpx solid #dceee8;
  border-radius: 32rpx;
  box-shadow: 0 12rpx 30rpx rgba(24, 50, 45, 0.04);
}

.starter-title {
  color: #18322d;
  font-size: 32rpx;
  font-weight: 900;
}

.starter-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 28rpx;
  margin-top: 36rpx;
}

.starter-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 152rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  font-weight: 900;
}

.starter-photo {
  color: #2d7ea7;
  background: #e4f5ff;
}

.starter-note {
  color: #5e56a7;
  background: #efecff;
}

.starter-box {
  color: #8a5b13;
  background: #fff1d3;
}

.starter-icon {
  width: 58rpx;
  height: 58rpx;
  margin-bottom: 18rpx;
  background: #ffffff;
  border-radius: 50%;
}

.default-footnote {
  margin: 32rpx 0 0;
  color: #8aa09a;
  font-size: 24rpx;
  line-height: 1.6;
}

.error-hero {
  min-height: 260rpx;
  background: #fff0eb;
}

.error-mark {
  color: #ffffff;
  background: #e96b56;
  border-color: #ffd0c4;
  font-size: 44rpx;
  font-weight: 900;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin: 24rpx 0;
}

.stat-card {
  padding: 30rpx;
  background: #ffffff;
  border: 1rpx solid #ddeee8;
  border-radius: 28rpx;
  box-shadow: 0 16rpx 44rpx rgba(10, 36, 28, 0.04);
}

.action-card:active {
  opacity: 0.82;
}

.stat-card text {
  color: #5f746f;
  font-size: 24rpx;
}

.stat-card view {
  margin-top: 12rpx;
  color: #18322d;
  font-size: 48rpx;
  font-weight: 800;
}

.stat-action {
  display: block;
  margin-top: 6rpx;
  color: #259f8e;
  font-size: 22rpx;
  font-weight: 800;
}

.section-action {
  color: #259f8e;
  font-size: 24rpx;
  font-weight: 800;
}

.card-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.action-btn {
  flex: 1 1 150rpx;
  min-width: 0;
  height: 58rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.hero-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin: 20rpx 0;
  padding: 32rpx;
  background: #ffffff;
  border: 1rpx solid #ddeee8;
  border-radius: 28rpx;
  box-shadow: 0 16rpx 44rpx rgba(10, 36, 28, 0.04);
}

.member-title {
  margin: 6rpx 0;
  color: #18322d;
  font-size: 32rpx;
  font-weight: 800;
}

.member-action {
  flex: 0 0 auto;
  padding: 12rpx 18rpx;
  color: #ffffff;
  background: #259f8e;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.hero-btn {
  flex: 0 0 196rpx;
  height: 72rpx;
  font-size: 26rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.quick-grid .ghost-btn {
  width: 100%;
  min-width: 0;
  height: 82rpx;
  font-weight: 800;
}
