.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin: 24rpx 0;
}

.stat-card {
  padding: 24rpx;
  background: #ffffff;
  border: 1rpx solid #dce4dd;
  border-radius: 16rpx;
}

.stat-card text {
  color: #66726c;
  font-size: 24rpx;
}

.stat-card view {
  margin-top: 12rpx;
  color: #102018;
  font-size: 48rpx;
  font-weight: 800;
}

.member-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin: 24rpx 0;
  padding: 26rpx;
  background: linear-gradient(135deg, #eef7f1 0%, #fff6e5 100%);
  border: 1rpx solid rgba(63, 125, 91, 0.12);
  border-radius: 18rpx;
}

.member-title {
  margin: 6rpx 0;
  color: #102018;
  font-size: 32rpx;
  font-weight: 800;
}

.member-action {
  flex: 0 0 auto;
  padding: 12rpx 18rpx;
  color: #ffffff;
  background: #2f7d57;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.quick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
