.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin: 24rpx 0;
}

.stat-card {
  padding: 24rpx;
  background: #ffffff;
  border: 1rpx solid #dce4dd;
  border-radius: 16rpx;
}

.stat-card text {
  color: #66726c;
  font-size: 24rpx;
}

.stat-card view {
  margin-top: 12rpx;
  color: #102018;
  font-size: 48rpx;
  font-weight: 800;
}

.quick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
