<view class="page">
  <view class="page-title">
    <text class="eyebrow">家人健康记</text>
    <view class="h1">{{family.name || '家庭健康管理'}}</view>
  </view>

  <view class="safety">{{safetyNotice}}</view>

  <view class="member-banner" bindtap="goMembership">
    <view>
      <text class="eyebrow">会员订阅</text>
      <view class="member-title">升级家庭共享与长期记录能力</view>
      <view class="muted">支持更多成员、共享协作、AI 额度和数据导出</view>
    </view>
    <text class="member-action">去开通</text>
  </view>

  <view class="stats-grid">
    <view class="stat-card">
      <text>家庭成员</text>
      <view>{{stats.members || 0}}</view>
    </view>
    <view class="stat-card">
      <text>常备记录</text>
      <view>{{stats.medicines || 0}}</view>
    </view>
    <view class="stat-card">
      <text>健康记录</text>
      <view>{{stats.illnessRecords || 0}}</view>
    </view>
    <view class="stat-card">
      <text>用药记录</text>
      <view>{{stats.medicationLogs || 0}}</view>
    </view>
  </view>

  <view class="quick-grid">
    <button class="ghost-btn" bindtap="goIllness">新增健康记录</button>
    <button class="ghost-btn" bindtap="goMedication">记录一次用药</button>
    <button class="ghost-btn" bindtap="goMedicinePhoto">拍照添加</button>
  </view>

  <view class="section">
    <view class="section-title">快过期药品</view>
    <view wx:if="{{!expiringMedicines.length}}" class="empty">暂无 60 天内到期药品</view>
    <view class="card-list" wx:else>
      <view class="record-card" wx:for="{{expiringMedicines}}" wx:key="_id">
        <view class="record-head">
          <view>
            <view class="record-title">{{item.name}}</view>
            <view class="muted">{{item.category}} · 剩余 {{item.remainingQuantity}}{{item.unit}}</view>
          </view>
          <text class="pill warn-pill">{{item.expireDate}}</text>
        </view>
        <view class="muted">位置：{{item.location || '未记录'}}</view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">低库存</view>
    <view wx:if="{{!lowStockMedicines.length}}" class="empty">暂无明显低库存药品</view>
    <view class="card-list" wx:else>
      <view class="record-card" wx:for="{{lowStockMedicines}}" wx:key="_id">
        <view class="record-title">{{item.name}}</view>
        <view class="muted">剩余 {{item.remainingQuantity}} / {{item.totalQuantity}}{{item.unit}}</view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">最近健康记录</view>
    <view wx:if="{{!illnessRecords.length}}" class="empty">还没有健康记录</view>
    <view class="card-list" wx:else>
      <view class="record-card" wx:for="{{illnessRecords}}" wx:key="_id">
        <view class="record-head">
          <view>
            <view class="record-title">{{item.memberName}} · {{item.symptomText}}</view>
            <view class="muted">{{item.timeText}} · {{item.status}}</view>
          </view>
        </view>
        <view>{{item.summary || item.symptomDescription || '暂无总结'}}</view>
      </view>
    </view>
  </view>

  <view class="ai-float" bindtap="goAssistant">
    <text class="ai-float-main">AI</text>
    <text class="ai-float-sub">问记录</text>
  </view>
</view>
