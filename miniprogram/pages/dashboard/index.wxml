<view class="page dashboard-page">
  <view wx:if="{{loadError}}" class="default-home error-home">
    <view class="default-brand">
      <view>
        <view class="default-title">家人健康记</view>
        <view class="default-subtitle">先把首页加载回来</view>
      </view>
      <view class="mini-menu">
        <text></text>
        <text></text>
      </view>
    </view>

    <view class="default-hero error-hero">
      <view class="hero-mark error-mark">!</view>
      <view class="hero-copy">
        <view class="hero-title">首页加载失败</view>
        <view class="hero-desc">{{loadError}}</view>
      </view>
    </view>

    <button class="default-primary" bindtap="retryLoadHome">重新加载</button>
    <button class="default-secondary" bindtap="goProfile">去我的页面</button>
  </view>

  <view wx:elif="{{loading}}" class="default-home">
    <view class="default-brand">
      <view>
        <view class="default-title">家人健康记</view>
        <view class="default-subtitle">正在准备家庭健康记录</view>
      </view>
      <view class="mini-menu">
        <text></text>
        <text></text>
      </view>
    </view>

    <view class="default-hero">
      <view class="hero-mark loading-mark"></view>
      <view class="hero-copy">
        <view class="hero-title">加载中</view>
        <view class="hero-desc">正在读取家庭成员、药箱、病程和用药记录。</view>
      </view>
    </view>
  </view>

  <view wx:elif="{{isDefaultHome}}" class="default-home">
    <view class="default-brand">
      <view>
        <view class="default-title">家人健康记</view>
        <view class="default-subtitle">先把第一个真实记录放进来</view>
      </view>
      <view class="mini-menu">
        <text></text>
        <text></text>
      </view>
    </view>

    <view class="default-hero">
      <view class="hero-mark">
        <view></view>
      </view>
      <view class="hero-copy">
        <view class="hero-title">还没有家庭健康档案</view>
        <view class="hero-desc">从一个成员、一条病程或一次上传开始，后续复诊摘要会自动串起来。</view>
      </view>
    </view>

    <button class="default-primary" wx:if="{{showWriteEntries}}" bindtap="goAddMember">添加家庭成员</button>
    <button class="default-secondary" wx:if="{{showWriteEntries}}" bindtap="goQuickIllness">先记录一次症状</button>

    <view class="starter-card" wx:if="{{showWriteEntries}}">
      <view class="starter-title">可以从这里开始</view>
      <view class="starter-grid">
        <view class="starter-item starter-photo" bindtap="goMedicinePhoto">
          <view class="starter-icon">
            <view class="camera-icon"><view class="camera-lens"></view></view>
          </view>
          <view>拍照录入药品</view>
        </view>
        <view class="starter-item starter-note" bindtap="goQuickIllness">
          <view class="starter-icon">
            <view class="note-icon">
              <view></view>
              <view></view>
              <view></view>
            </view>
          </view>
          <view>手动记录</view>
        </view>
        <view class="starter-item starter-box" bindtap="goMedicines">
          <view class="starter-icon">
            <view class="box-icon">
              <view class="box-cross"></view>
            </view>
          </view>
          <view>管理药箱</view>
        </view>
      </view>
    </view>
  </view>

  <block wx:else>
    <view class="page-title">
      <view class="h1">生病记录与复诊摘要</view>
    </view>

    <view class="hero-action">
      <view>
        <text class="eyebrow">{{family.name || '我的家庭'}}</text>
        <view class="member-title">孩子生病不用靠回忆</view>
        <view class="muted">快速记下体温、症状、用药和复诊要点。</view>
      </view>
      <button class="primary-btn hero-btn" wx:if="{{showWriteEntries}}" bindtap="goQuickIllness">记一次生病</button>
    </view>

    <view class="stats-grid">
      <view class="stat-card action-card" data-target="members" bindtap="goByStat">
        <text>家庭成员</text>
        <view>{{stats.members || 0}}</view>
        <text class="stat-action">查看成员</text>
      </view>
      <view class="stat-card action-card" data-target="medicines" bindtap="goByStat">
        <text>药箱记录</text>
        <view>{{stats.medicines || 0}}</view>
        <text class="stat-action">{{showWriteEntries ? '管理药箱' : '查看药箱'}}</text>
      </view>
      <view class="stat-card action-card" data-target="illness" bindtap="goByStat">
        <text>健康记录</text>
        <view>{{stats.illnessRecords || 0}}</view>
        <text class="stat-action">查看病程</text>
      </view>
      <view class="stat-card action-card" data-target="medication" bindtap="goByStat">
        <text>用药记录</text>
        <view>{{stats.medicationLogs || 0}}</view>
        <text class="stat-action">{{showWriteEntries ? '记录用药' : '查看用药'}}</text>
      </view>
    </view>

    <view class="quick-grid" wx:if="{{showWriteEntries}}">
      <button class="ghost-btn" bindtap="goQuickIllness">快速记录</button>
      <button class="ghost-btn" bindtap="createMedication">记录一次用药</button>
      <button class="ghost-btn" bindtap="goMedicinePhoto">拍照录入药品</button>
    </view>

    <view class="section">
      <view class="section-title">进行中的病程</view>
      <view wx:if="{{!activeCourses.length && showWriteEntries}}" class="empty" bindtap="goQuickIllness">暂无进行中的病程，点这里记录一次</view>
      <view wx:elif="{{!activeCourses.length}}" class="empty">暂无进行中的病程</view>
      <view class="card-list" wx:else>
        <view class="record-card" wx:for="{{activeCourses}}" wx:key="_id" data-id="{{item._id}}" bindtap="goIllnessDetail">
          <view class="record-head">
            <view>
              <view class="record-title">{{item.memberName}} · {{item.symptomText}}</view>
              <view class="muted">{{item.timeText}} · {{item.status}}</view>
            </view>
            <text class="pill">看时间线</text>
          </view>
          <view>{{item.summary || item.symptomDescription || '继续追加体温、症状、用药记录'}}</view>
          <view class="card-actions" wx:if="{{showWriteEntries}}">
            <button class="ghost-btn action-btn" data-id="{{item._id}}" catchtap="addCourseEvent">追加记录</button>
            <button class="ghost-btn action-btn" data-id="{{item._id}}" data-member="{{item.memberId}}" catchtap="goCourseMedication">记录用药</button>
            <button class="ghost-btn action-btn" data-id="{{item._id}}" catchtap="goCourseReport">复诊摘要</button>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">
        <text>快过期药品</text>
        <text class="section-action" bindtap="goMedicines">查看全部</text>
      </view>
      <view wx:if="{{!expiringMedicines.length}}" class="empty" bindtap="goMedicines">暂无 {{expiryReminderDays}} 天内到期药品，点这里检查药箱</view>
      <view class="card-list" wx:else>
        <view class="record-card action-card" wx:for="{{expiringMedicines}}" wx:key="_id" data-id="{{item._id}}" data-reason="expire" bindtap="handleMedicine">
          <view class="record-head">
            <view>
              <view class="record-title">{{item.name}}</view>
              <view class="muted">{{item.category}} · 剩余 {{item.remainingQuantity}}{{item.unit}}</view>
            </view>
            <text class="expire-text {{item.expireStatus === 'expired' ? 'expire-expired' : 'expire-expiring'}}">{{item.expireLabel}}</text>
          </view>
          <view class="muted">位置：{{item.location || '未记录'}}</view>
          <view class="card-actions" wx:if="{{showWriteEntries}}">
            <button class="ghost-btn action-btn" data-id="{{item._id}}" data-reason="expire" catchtap="handleMedicine">处理/修改</button>
            <button class="ghost-btn action-btn" catchtap="goMedicinePhoto">补拍包装</button>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">
        <text>低库存</text>
        <text class="section-action" bindtap="goMedicines">查看全部</text>
      </view>
      <view wx:if="{{!lowStockMedicines.length}}" class="empty" bindtap="goMedicines">暂无明显低库存药品，点这里管理药箱</view>
      <view class="card-list" wx:else>
        <view class="record-card action-card" wx:for="{{lowStockMedicines}}" wx:key="_id" data-id="{{item._id}}" data-reason="stock" bindtap="handleMedicine">
          <view class="record-title">{{item.name}}</view>
          <view class="muted">{{item.stockSummary}}</view>
          <view class="card-actions" wx:if="{{showWriteEntries}}">
            <button class="ghost-btn action-btn" data-id="{{item._id}}" data-reason="stock" catchtap="handleMedicine">补库存/修改</button>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">
        <text>最近病程</text>
        <text class="section-action" bindtap="goIllness">查看全部</text>
      </view>
      <view wx:if="{{!illnessRecords.length && showWriteEntries}}" class="empty" bindtap="goQuickIllness">还没有病程，点这里记录一次</view>
      <view wx:elif="{{!illnessRecords.length}}" class="empty">还没有病程记录</view>
      <view class="card-list" wx:else>
        <view class="record-card" wx:for="{{illnessRecords}}" wx:key="_id" data-id="{{item._id}}" bindtap="goIllnessDetail">
          <view class="record-head">
            <view>
              <view class="record-title">{{item.memberName}} · {{item.symptomText}}</view>
              <view class="muted">{{item.timeText}} · {{item.status}}</view>
            </view>
          </view>
          <view>{{item.summary || item.symptomDescription || '暂无总结'}}</view>
          <view class="card-actions" wx:if="{{showWriteEntries}}">
            <button class="ghost-btn action-btn" data-id="{{item._id}}" catchtap="addCourseEvent">追加</button>
            <button class="ghost-btn action-btn" data-id="{{item._id}}" catchtap="goCourseReport">摘要</button>
          </view>
        </view>
      </view>
    </view>

  </block>
</view>
<global-auth-layer id="global-auth-layer" bindloginsuccess="handleLoginSuccess" />
