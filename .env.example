# Local dev uses /api/admin and a development-only token automatically.
# Production must point to a trusted gateway that authenticates administrators
# with a server-managed HttpOnly session. Never put an admin secret in VITE_*.
VITE_ADMIN_API_BASE=https://your-admin-api-endpoint.example.com

# Non-secret production release attestations. Set true only after evidence exists.
WECHAT_CLOUD_DEPLOYED=false
WECHAT_DB_ADMINONLY_CONFIRMED=false
WECHAT_PRIVACY_GUIDE_CONFIGURED=false
WECHAT_TWO_ACCOUNT_E2E_PASSED=false
WECHAT_REAL_DEVICE_MATRIX_PASSED=false

# 微信订阅消息由 reminderDispatcher 云函数读取；字段名必须与公众平台模板完全一致。
HEALTH_TODO_TEMPLATE_ID=
HEALTH_TODO_TEMPLATE_FIELDS={"title":"thing1","time":"time2","member":"thing3","note":"thing4"}
HEALTH_TODO_MINIPROGRAM_STATE=formal
WECHAT_HEALTH_TODO_TEMPLATE_CONFIGURED=false
WECHAT_REMINDER_TRIGGER_DEPLOYED=false
WECHAT_REMINDER_REAL_DEVICE_PASSED=false
