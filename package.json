{
  "name": "jiaren-health-note-admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "check:js": "node scripts/check-js-syntax.cjs",
    "check:miniprogram": "node scripts/check-miniprogram-config.cjs",
    "check:actions": "node scripts/check-action-coverage.cjs",
    "test": "node --test tests/*.test.cjs",
    "check:security": "node scripts/check-security-readiness.cjs",
    "check:release": "node scripts/check-release-readiness.cjs",
    "check:release:production": "node scripts/check-release-readiness.cjs --production",
    "check": "npm run build && npm run lint && npm run check:js && npm run check:miniprogram && npm run check:actions && npm test && npm run check:release",
    "check:ci": "npm run check",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
